---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import BlogHero from '../../../components/blog/BlogHero.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import Button from '../../../components/common/Button.astro';
import Container from '../../../components/common/Container.astro';
import { site } from '../../../data/site';
import { absoluteUrl } from '../../../utils/seo';
import {
  getCategories,
  getPublishedPosts,
  slugifyCategory,
  sortPostsByDate,
} from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));
  const categories = getCategories(posts);

  return categories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: {
      category,
      posts: sortPostsByDate(posts.filter((post) => post.data.category === category)),
    },
  }));
}

const { category, posts } = Astro.props;
const categorySlug = slugifyCategory(category);
const categoryUrl = `/blog/category/${categorySlug}`;
const categoryDescriptions: Record<string, string> = {
  Awareness:
    'Read Mahaa Foundation articles about cleanliness awareness, plastic-free awareness, public responsibility, and community action.',
  'Community Welfare':
    'Read Mahaa Foundation articles about community welfare, food donation, volunteering, and practical social service.',
  'Health Support':
    'Read Mahaa Foundation articles about health camp support, public health awareness, and community coordination.',
  'Ration Distribution':
    'Read Mahaa Foundation articles about ration distribution, food donation, family support, and community welfare.',
  'Social Service':
    'Read Mahaa Foundation articles about social service, youth participation, public support, and community responsibility.',
  'Student Support':
    'Read Mahaa Foundation articles about student support, government school children, education supplies, and community care.',
  'Tree Plantation':
    'Read Mahaa Foundation articles about tree plantation in Mahalingpur, sapling care, and greener public spaces.',
  Volunteering:
    'Read Mahaa Foundation articles about volunteering, youth participation, social service, and responsible public action.',
};
const description =
  categoryDescriptions[category] ??
  `Read Mahaa Foundation articles about ${category.toLowerCase()}, community welfare, social service, and awareness.`;

const page = {
  title: `${category} Articles | Mahaa Foundation Blog`,
  description,
  canonical: categoryUrl,
  ogTitle: `${category} Articles | Mahaa Foundation Blog`,
  ogDescription: description,
  ogImage: '/images/og/blog-og.jpg',
  twitterImage: '/images/og/blog-og.jpg',
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${category} Articles`,
      url: absoluteUrl(categoryUrl),
      description,
      isPartOf: {
        '@type': 'Blog',
        name: 'Mahaa Foundation Blog and Updates',
        url: absoluteUrl('/blog'),
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('/blog') },
        { '@type': 'ListItem', position: 3, name: category, item: absoluteUrl(categoryUrl) },
      ],
    },
  ],
};
---

<BaseLayout {...page}>
  <BlogHero
    eyebrow="Blog Category"
    title={`${category} Articles`}
    description={description}
  />

  <section class="category-listing" aria-labelledby="category-listing-title">
    <Container>
      <div class="category-listing__header">
        <a href="/blog">Back to all blog posts</a>
        <h2 id="category-listing-title">Articles in {category}</h2>
      </div>
      <div class="blog-grid">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}`}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
              category={post.data.category}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <section class="category-cta" aria-labelledby="category-cta-title">
    <Container>
      <div class="category-cta__band">
        <div>
          <h2 id="category-cta-title">Want to Support This Work?</h2>
          <p>
            Join our NGO activities, support community welfare, or contact us to collaborate in
            {site.city}.
          </p>
        </div>
        <div>
          <Button href="/volunteer" variant="primary">Become a Volunteer</Button>
          <Button href="/donate" variant="outline">Donate Now</Button>
          <Button href="/contact" variant="outline">Contact Us</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .category-listing,
  .category-cta {
    padding: var(--space-7) 0;
  }

  .category-listing__header {
    margin-bottom: var(--space-5);
  }

  .category-listing__header a {
    color: var(--color-primary-dark);
    font-weight: 900;
  }

  .blog-grid {
    display: grid;
    gap: var(--space-4);
  }

  .category-cta {
    background: var(--color-bg-soft);
  }

  .category-cta__band {
    display: grid;
    gap: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    padding: var(--space-6);
  }

  .category-cta p {
    color: var(--color-muted);
  }

  .category-cta__band > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 760px) {
    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 920px) {
    .category-cta__band {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
