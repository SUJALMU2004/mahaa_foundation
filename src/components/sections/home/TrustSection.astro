---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import { home } from '../../../data/home';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const { trustCards, trustSection } = home[lang];
---

<section class="trust-section" aria-labelledby="trust-title">
  <Container>
    <SectionHeader
      headingId="trust-title"
      eyebrow={trustSection.eyebrow}
      title={trustSection.title}
      description={trustSection.description}
    />

    <div class="trust-grid">
      {
        trustCards.map((card) => (
          <article class="trust-card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .trust-section {
    padding: var(--space-8) 0;
    background:
      linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);
  }

  .trust-grid {
    display: grid;
    gap: var(--space-4);
  }

  .trust-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .trust-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .trust-card h3 {
    position: relative;
    padding-top: var(--space-5);
  }

  .trust-card h3::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 3px;
    border-radius: 999px;
    background: var(--gradient-accent);
    content: "";
  }

  .trust-card p {
    margin-bottom: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (min-width: 760px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-card {
      transition: none;
    }
    .trust-card:hover {
      transform: none;
    }
  }
</style>
