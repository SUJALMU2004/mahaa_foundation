---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import { home } from '../../../data/home';
---

<section class="trust-section" aria-labelledby="trust-title">
  <Container>
    <SectionHeader
      headingId="trust-title"
      eyebrow="Why Join Us"
      title="Why People Join Our Mission"
      description="Our work is built on community participation, transparent intentions, and a strong commitment to people and nature."
    />

    <div class="trust-grid">
      {
        home.trustCards.map((card) => (
          <article class="trust-card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .trust-section {
    padding: var(--space-7) 0;
    background: #ffffff;
  }

  .trust-grid {
    display: grid;
    gap: var(--space-4);
  }

  .trust-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, #ffffff, var(--color-bg-soft));
    padding: var(--space-5);
  }

  .trust-card h3 {
    position: relative;
    padding-top: var(--space-5);
  }

  .trust-card h3::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-accent);
    content: "";
  }

  .trust-card p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (min-width: 760px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
