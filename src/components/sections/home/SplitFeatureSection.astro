---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import type { Cta, MediaPlaceholder } from '../../../data/home';
import { Image } from 'astro:assets';


export interface Props {
  id: string;
  eyebrow: string;
  title: string;
  content: string;
  bullets: readonly string[];
  primaryCta: Cta;
  secondaryCta: Cta;
  media: MediaPlaceholder;
  reverse?: boolean;
}

const {
  id,
  eyebrow,
  title,
  content,
  bullets,
  primaryCta,
  secondaryCta,
  media,
  reverse = false,
} = Astro.props;

const headingId = `${id}-title`;
---

<section class:list={['split-feature', reverse && 'split-feature--reverse']} aria-labelledby={headingId}>
  <Container>
    <div class="split-feature__grid">
      <div class="split-feature__media">
        <Image
          src={media.image}
          alt={media.alt}
          width={900}
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
        <span>{media.label}</span>
      </div>

      <div class="split-feature__content">
        <p class="split-feature__eyebrow">{eyebrow}</p>
        <h2 id={headingId}>{title}</h2>
        <p>{content}</p>
        <ul>
          {bullets.map((item) => <li>{item}</li>)}
        </ul>
        <div class="split-feature__actions">
          <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
          <Button href={secondaryCta.href} variant="outline">{secondaryCta.label}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .split-feature {
    padding: var(--space-8) 0;
  }

  .split-feature--reverse {
    background: var(--color-bg-soft);
  }

  .split-feature__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .split-feature__media {
    position: relative;
    display: block;
    width: 100%;
    min-height: 300px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-md);
  }

  .split-feature__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
    object-position: center;
  }

  .split-feature__media span {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    color: var(--color-primary-dark);
    padding: 0.6rem 0.85rem;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
  }

  .split-feature__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .split-feature__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .split-feature__content > p {
    color: var(--color-muted);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .split-feature ul {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    padding-left: 0;
    list-style: none;
  }

  .split-feature li {
    position: relative;
    padding-left: 1.6rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .split-feature li::before {
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
  }

  .split-feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .split-feature__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: var(--space-8);
    }

    .split-feature__media,
    .split-feature__media img {
      min-height: 380px;
    }

    .split-feature--reverse .split-feature__media {
      order: 2;
    }
  }

  @media (min-width: 1180px) {
    .split-feature__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .split-feature__media,
    .split-feature__media img {
      min-height: 430px;
    }
  }

  @media (max-width: 420px) {
    .split-feature__actions :global(.button) {
      width: 100%;
    }
  }
</style>
