---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import type { Cta, MediaPlaceholder } from '../../../data/home';

export interface Props {
  id: string;
  eyebrow: string;
  title: string;
  content: string;
  bullets: readonly string[];
  primaryCta: Cta;
  secondaryCta: Cta;
  media: MediaPlaceholder;
  reverse?: boolean;
}

const {
  id,
  eyebrow,
  title,
  content,
  bullets,
  primaryCta,
  secondaryCta,
  media,
  reverse = false,
} = Astro.props;

const headingId = `${id}-title`;
---

<section class:list={['split-feature', reverse && 'split-feature--reverse']} aria-labelledby={headingId}>
  <Container>
    <div class="split-feature__grid">
      <div
        class="split-feature__media"
        role="img"
        aria-label={media.alt}
        data-image={media.image}
        style={`--media-image: url("${media.image}")`}
      >
        <span>{media.label}</span>
      </div>

      <div class="split-feature__content">
        <p class="split-feature__eyebrow">{eyebrow}</p>
        <h2 id={headingId}>{title}</h2>
        <p>{content}</p>
        <ul>
          {bullets.map((item) => <li>{item}</li>)}
        </ul>
        <div class="split-feature__actions">
          <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
          <Button href={secondaryCta.href} variant="outline">{secondaryCta.label}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .split-feature {
    padding: var(--space-8) 0;
  }

  .split-feature--reverse {
    background: var(--color-bg-soft);
  }

  .split-feature__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .split-feature__media {
    display: grid;
    min-height: 260px;
    aspect-ratio: 4 / 3;
    place-items: end start;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-image:
      linear-gradient(160deg, rgba(15, 107, 69, 0.12), rgba(214, 166, 74, 0.08)),
      var(--media-image),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.6) 0 14px,
        rgba(15, 107, 69, 0.04) 14px 28px
      ),
      var(--color-primary-soft);
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-md);
    padding: var(--space-4);
  }

  .split-feature__media span {
    display: inline-flex;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    color: var(--color-primary-dark);
    padding: 0.6rem 0.85rem;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
  }

  .split-feature__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .split-feature__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .split-feature__content > p {
    color: var(--color-muted);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .split-feature ul {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    padding-left: 0;
    list-style: none;
  }

  .split-feature li {
    position: relative;
    padding-left: 1.6rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .split-feature li::before {
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: "";
  }

  .split-feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .split-feature__grid {
      grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
    }

    .split-feature--reverse .split-feature__media {
      order: 2;
    }
  }

  @media (max-width: 420px) {
    .split-feature__actions :global(.button) {
      width: 100%;
    }
  }
</style>
