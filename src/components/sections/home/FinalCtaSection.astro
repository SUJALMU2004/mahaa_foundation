---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { whatsappUrl } from '../../../utils/seo';

const cta = home.ctas.final;
const whatsappHref = whatsappUrl(cta.whatsappMessage);
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <Container>
    <div class="final-cta__inner">
      <p class="final-cta__eyebrow">Take Action</p>
      <h2 id="final-cta-title">{cta.title}</h2>
      <p>{cta.content}</p>
      <div class="final-cta__actions">
        <Button href="/volunteer" variant="primary">Become a Volunteer</Button>
        <Button href="/donate" variant="secondary">Donate Now</Button>
        <Button href="/contact" variant="outline">Contact Us</Button>
        <Button href={whatsappHref} variant="whatsapp" external>WhatsApp Us</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .final-cta {
    padding: var(--space-8) 0 var(--space-9);
    background: #ffffff;
  }

  .final-cta__inner {
    position: relative;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--gradient-dark);
    padding: clamp(2.5rem, 7vw, 5rem);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .final-cta__inner::after {
    position: absolute;
    right: -6rem;
    bottom: -9rem;
    width: 20rem;
    height: 20rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    content: "";
  }

  .final-cta__eyebrow {
    margin-bottom: var(--space-2);
    position: relative;
    z-index: 1;
    color: #efc979;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .final-cta h2,
  .final-cta p {
    position: relative;
    z-index: 1;
    margin-inline: auto;
  }

  .final-cta h2 {
    max-width: 780px;
    color: #ffffff;
  }

  .final-cta p:not(.final-cta__eyebrow) {
    max-width: 620px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.05rem;
  }

  .final-cta__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .final-cta :global(.button--primary) {
    background: var(--color-accent);
    color: var(--color-primary-dark);
  }

  .final-cta :global(.button--primary:hover) {
    background: #efc979;
    color: var(--color-primary-dark);
  }

  .final-cta :global(.button--secondary) {
    background: #ffffff;
    color: var(--color-primary-dark);
  }

  .final-cta :global(.button--secondary:hover) {
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }

  .final-cta :global(.button--outline) {
    border-color: rgba(255, 255, 255, 0.5);
    color: #ffffff;
  }

  .final-cta :global(.button--outline:hover) {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 420px) {
    .final-cta__actions :global(.button) {
      width: 100%;
    }
  }
</style>
