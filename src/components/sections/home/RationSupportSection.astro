---
import SplitFeatureSection from './SplitFeatureSection.astro';
import { home } from '../../../data/home';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';
const lang = getLangFromUrl(Astro.url);

const section = home[lang].focusedWorkSections.rationSupport;
---

<SplitFeatureSection id="ration-support-home" {...section} reverse />
