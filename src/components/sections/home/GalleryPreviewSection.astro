---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { Image } from 'astro:assets';
---

<section class="gallery-section" aria-labelledby="gallery-title">
  <Container>
    <div class="gallery-section__heading">
      <SectionHeader
        headingId="gallery-title"
        eyebrow="Activity Moments"
        title="Moments from Our Activities"
        description="A glimpse of our plantation drives, ration distribution activities, environmental campaigns, and volunteer work."
      />
      <div class="gallery-section__actions">
        <Button href="/gallery" variant="outline">View Gallery</Button>
        <Button href="/activities" variant="link">View Activities</Button>
      </div>
    </div>

    <div class="gallery-grid">
      {
        home.galleryPreview.map((item) => (
          <figure class="gallery-card">
            <div class="gallery-card__media">
              <Image
                src={item.image}
                alt={item.alt}
                width={520}
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .gallery-section {
    padding: var(--space-8) 0;
    background: var(--color-bg-soft);
  }

  .gallery-section__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .gallery-section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-4);
  }

  .gallery-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .gallery-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .gallery-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-soft);
  }

  .gallery-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-card figcaption {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    font-weight: 700;
    font-size: 0.94rem;
  }

  @media (min-width: 760px) {
    .gallery-section__heading {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card {
      transition: none;
    }
    .gallery-card:hover {
      transform: none;
    }
  }
</style>
