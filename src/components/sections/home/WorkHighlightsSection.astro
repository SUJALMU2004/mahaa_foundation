---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';

const workCardColumns = home.workHighlights.length === 5 ? 'work-grid--five' : '';
---

<section class="work-section" aria-labelledby="work-title">
  <Container>
    <div class="work-section__heading">
      <SectionHeader
        headingId="work-title"
        eyebrow="Work Areas"
        title="Our Work for Society and Mahalingpur"
        description="From ration distribution to student support, tree plantation, health camp support, and awareness programs, our work focuses on practical community impact."
      />
      <Button href="/our-work" variant="outline">See All Work</Button>
    </div>

    <div class={`work-grid ${workCardColumns}`}>
      {
        home.workHighlights.map((item) => (
          <article class="work-card">
            <a
              class="work-card__media-link"
              href={item.href}
              aria-label={`Explore ${item.title}`}
              data-image={item.image}
              style={`--media-image: url("${item.image}")`}
            ></a>
            <div class="work-card__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.href}>Explore {item.title}</a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .work-section {
    padding: var(--space-7) 0;
    background: var(--color-bg-soft);
  }

  .work-section__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .work-grid {
    display: grid;
    gap: var(--space-5);
  }

  .work-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .work-card:hover {
    border-color: rgb(23 107 58 / 0.28);
    box-shadow: 0 16px 36px rgb(23 35 29 / 0.09);
    transform: translateY(-3px);
  }

  .work-card__media-link {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background-color: #eef4ee;
    background-image: var(--media-image);
    background-position: center;
    background-size: cover;
    transition: transform 180ms ease;
  }

  .work-card__media-link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  .work-card:hover .work-card__media-link {
    transform: scale(1.035);
  }

  .work-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .work-card h3 {
    margin-bottom: var(--space-2);
  }

  .work-card p {
    flex: 1;
    color: var(--color-muted);
  }

  .work-card a {
    color: var(--color-primary-dark);
    font-weight: 900;
    text-decoration: none;
  }

  .work-card a:hover {
    text-decoration: underline;
  }

  .work-card a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (min-width: 760px) {
    .work-section__heading {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .work-card {
      grid-column: span 2;
    }

    .work-grid--five .work-card:nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .work-grid--five .work-card:last-child {
      grid-column: 4 / span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card__media-link {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
