---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { Image } from 'astro:assets';

const workCardColumns = home.workHighlights.length === 5 ? 'work-grid--five' : '';
---

<section class="work-section" aria-labelledby="work-title">
  <Container>
    <div class="work-section__heading">
      <SectionHeader
        headingId="work-title"
        eyebrow="Work Areas"
        title="Our Work for Society and Mahalingpur"
        description="From ration distribution to student support, tree plantation, health camp support, and awareness programs, our work focuses on practical community impact."
      />
      <Button href="/our-work" variant="outline">See All Work</Button>
    </div>

    <div class={`work-grid ${workCardColumns}`}>
      {
        home.workHighlights.map((item) => (
          <article class="work-card">
            <a
              class="work-card__media-link"
              href={item.href}
              aria-label={`Explore ${item.title}`}
            >
              <Image
                src={item.image}
                alt={item.imageAlt}
                width={640}
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="work-card__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a href={item.href}>Explore {item.title}</a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .work-section {
    padding: var(--space-9) 0;
    background: var(--color-bg-warm);
  }

  .work-section__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .work-grid {
    display: grid;
    gap: var(--space-5);
  }

  .work-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .work-card:hover {
    border-color: rgba(15, 107, 69, 0.2);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .work-card__media-link {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    transition: transform 300ms ease;
  }

  .work-card__media-link :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .work-card__media-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .work-card:hover .work-card__media-link :global(img) {
    transform: scale(1.04);
  }

  .work-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .work-card h3 {
    margin-bottom: var(--space-2);
  }

  .work-card p {
    flex: 1;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .work-card a:not(.work-card__media-link) {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .work-card a:not(.work-card__media-link):hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .work-card a:not(.work-card__media-link):focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (min-width: 760px) {
    .work-section__heading {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .work-card {
      grid-column: span 2;
    }

    .work-grid--five .work-card:nth-last-child(2) {
      grid-column: 2 / span 2;
    }

    .work-grid--five .work-card:last-child {
      grid-column: 4 / span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card__media-link {
      transition: none;
    }

    .work-card:hover {
      transform: none;
    }
  }
</style>
