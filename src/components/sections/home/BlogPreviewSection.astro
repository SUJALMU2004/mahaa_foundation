---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
---

<section class="blog-section" aria-labelledby="blog-title">
  <Container>
    <div class="blog-section__heading">
      <SectionHeader
        headingId="blog-title"
        eyebrow="NGO Blog"
        title="Latest From Our NGO Blog"
        description="Read updates, awareness articles, and stories about social service, tree plantation, student support, health support, awareness, and community welfare."
      />
      <Button href="/blog" variant="outline">Visit Blog</Button>
    </div>

    <div class="blog-grid">
      {
        home.blogPreview.map((post) => (
          <article class="blog-card">
            <p class="blog-card__category">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <a href={post.href}>Read updates on the blog</a>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .blog-section {
    padding: var(--space-8) 0;
    background:
      linear-gradient(180deg, var(--color-bg-soft), #ffffff);
  }

  .blog-section__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .blog-section__heading :global(.section-header) {
    max-width: 760px;
  }

  .blog-grid {
    display: grid;
    gap: var(--space-4);
  }

  .blog-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .blog-card__category {
    display: inline-flex;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .blog-card p:not(.blog-card__category) {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .blog-card a {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-card a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 760px) {
    .blog-section__heading {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .blog-section__heading :global(.button) {
      margin-top: var(--space-5);
    }

    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
    .blog-card:hover {
      transform: none;
    }
  }
</style>
