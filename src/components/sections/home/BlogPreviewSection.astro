---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { blogSection } = home[lang];
---

<section class="blog-section" aria-labelledby="blog-title">
  <Container>
    <div class="blog-section__heading">
      <SectionHeader
        headingId="blog-title"
        eyebrow={blogSection.eyebrow}
        title={blogSection.title}
        description={blogSection.description}
      />
      <Button href={translatePath('/blog', lang)} variant="outline">{blogSection.visitBlogBtn}</Button>
    </div>

    <div class="blog-grid">
      {home[lang].blogPreview.map((post) => (
          <article class="blog-card">
            <p class="blog-card__category">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <a href={translatePath(post.href, lang)}>{blogSection.readUpdatesText}</a>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .blog-section {
    padding: var(--space-8) 0;
    background:
      linear-gradient(180deg, var(--color-bg-soft), #ffffff);
  }

  .blog-section__heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .blog-section__heading :global(.section-header) {
    max-width: 760px;
  }

  .blog-grid {
    display: grid;
    gap: var(--space-4);
  }

  .blog-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .blog-card:hover {
    border-color: rgba(15, 107, 69, 0.22);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .blog-card__category {
    display: inline-flex;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .blog-card h3 {
    min-height: 2.75em;
    margin-bottom: var(--space-3);
  }

  .blog-card h3,
  .blog-card p:not(.blog-card__category) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .blog-card h3 {
    -webkit-line-clamp: 2;
  }

  .blog-card p:not(.blog-card__category) {
    color: var(--color-muted);
    line-height: 1.65;
    -webkit-line-clamp: 3;
  }

  .blog-card a {
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-card a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 760px) {
    .blog-section__heading {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .blog-section__heading :global(.button) {
      margin-top: var(--space-5);
    }

    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
    .blog-card:hover {
      transform: none;
    }
  }
</style>
