---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';

const { hero } = home;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Container>
    <div class="home-hero__grid">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{hero.eyebrow}</p>
        <h1 id="home-hero-title">{hero.title}</h1>
        <p class="home-hero__kannada">{hero.kannadaLine}</p>
        <p class="home-hero__lead">{hero.description}</p>
        <p class="home-hero__phrase"><span>Focus:</span> {hero.phrase}</p>

        <div class="home-hero__actions" aria-label="Homepage actions">
          <Button href={hero.ctas[0].href} variant="primary">{hero.ctas[0].label}</Button>
          <Button href={hero.ctas[1].href} variant="outline">{hero.ctas[1].label}</Button>
        </div>
      </div>

      <div class="home-hero__media-wrapper">
        <div
          class="home-hero__media"
          role="img"
          aria-label={hero.media.alt}
          data-image={hero.media.image}
          style={`--media-image: url("${hero.media.image}")`}
        >
        </div>
        <p class="home-hero__media-caption">{hero.media.label} — {hero.phrase}</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    padding: var(--space-9) 0 var(--space-8);
    background: var(--color-bg-soft);
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .home-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 15ch;
  }

  .home-hero__lead {
    max-width: 44rem;
    color: var(--color-muted);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .home-hero__kannada {
    max-width: 44rem;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .home-hero__phrase {
    margin-bottom: var(--space-5);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .home-hero__phrase span {
    color: var(--color-accent-dark);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-right: var(--space-2);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__media-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-hero__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background-image: var(--media-image);
    background-position: center;
    background-size: cover;
  }

  .home-hero__media-caption {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    }
  }

  @media (max-width: 420px) {
    .home-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
