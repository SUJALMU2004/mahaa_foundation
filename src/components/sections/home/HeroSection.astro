---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';

const { hero } = home;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Container>
    <div class="home-hero__grid">
      <div class="home-hero__content">
        <p class="home-eyebrow">{hero.eyebrow}</p>
        <h1 id="home-hero-title">{hero.title}</h1>
        <p class="home-hero__kannada">{hero.kannadaLine}</p>
        <p class="home-hero__lead">{hero.description}</p>
        <p class="home-hero__phrase">{hero.phrase}</p>

        <div class="home-hero__actions" aria-label="Homepage actions">
          <Button href={hero.ctas[0].href} variant="primary">{hero.ctas[0].label}</Button>
          <Button href={hero.ctas[1].href} variant="secondary">{hero.ctas[1].label}</Button>
        </div>
      </div>

      <div
        class="home-hero__media"
        role="img"
        aria-label={hero.media.alt}
        data-image={hero.media.image}
        style={`--media-image: url("${hero.media.image}")`}
      >
        <div class="home-hero__media-card">
          <span>{hero.media.label}</span>
          <strong>{hero.phrase}</strong>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    padding: var(--space-7) 0 var(--space-6);
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .home-eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 13ch;
  }

  .home-hero__lead {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .home-hero__kannada {
    max-width: 44rem;
    color: var(--color-primary-dark);
    font-weight: 900;
  }

  .home-hero__phrase {
    display: inline-flex;
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-text);
    padding: var(--space-3) var(--space-4);
    font-weight: 900;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }

  .home-hero__media {
    display: grid;
    min-height: 320px;
    aspect-ratio: 4 / 3;
    place-items: end start;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-image:
      linear-gradient(135deg, rgb(23 107 58 / 0.16), rgb(217 140 36 / 0.14)),
      var(--media-image),
      repeating-linear-gradient(
        135deg,
        rgb(23 107 58 / 0.08) 0 12px,
        rgb(255 255 255 / 0.6) 12px 24px
      ),
      var(--color-bg-soft);
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
  }

  .home-hero__media-card {
    width: min(100%, 360px);
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.9);
    padding: var(--space-4);
    box-shadow: var(--shadow-soft);
  }

  .home-hero__media-card span {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .home-hero__media-card strong {
    display: block;
    color: var(--color-primary-dark);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .home-hero {
      padding: var(--space-8) 0 var(--space-7);
    }

    .home-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    }
  }

  @media (max-width: 420px) {
    .home-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
