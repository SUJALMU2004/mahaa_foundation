---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';
import { Image } from 'astro:assets';
const lang = getLangFromUrl(Astro.url);

const translatePath = useTranslatedPath(lang);
const { hero } = home[lang];
---

<section class="home-hero" aria-labelledby="home-hero-title" data-lang={lang}>
  <Container>
    <div class="home-hero__grid">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{hero.eyebrow}</p>
        <h1 id="home-hero-title" class={lang === 'kn' ? 'is-kannada' : ''}>{hero.title}</h1>
        {hero.kannadaLine && <p class="home-hero__kannada">{hero.kannadaLine}</p>}
        <p class="home-hero__lead">{hero.description}</p>
        {hero.phrase && <p class="home-hero__phrase"><span>{hero.focusPrefix}</span> {hero.phrase}</p>}

        <div class="home-hero__actions" aria-label="Homepage actions">
          <Button href={translatePath(hero.ctas[0].href, lang)} variant="primary">{hero.ctas[0].label}</Button>
          <Button href={translatePath(hero.ctas[1].href, lang)} variant="outline">{hero.ctas[1].label}</Button>
        </div>
      </div>

      <div class="home-hero__media-wrapper">
        <div class="home-hero__media">
          <Image
            src={hero.media.image}
            alt={hero.media.alt}
            width={1200}
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <p class="home-hero__media-caption">{hero.media.label} — {hero.phrase}</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    padding: var(--space-6) 0;
    background: var(--color-bg-soft);
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .home-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 13.5ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2.8rem, 5.8vw, 5.6rem);
    line-height: 0.98;
    overflow-wrap: anywhere;
  }

  .home-hero h1.is-kannada {
    max-width: 100%;
    font-size: clamp(1.75rem, 6.5vw, 3.4rem);
    line-height: 1.2;
    overflow-wrap: normal;
    word-break: normal;
  }

  .home-hero__lead {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1.04rem;
    line-height: 1.72;
  }

  .home-hero__kannada {
    max-width: 44rem;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .home-hero__phrase {
    margin-bottom: var(--space-5);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .home-hero__phrase span {
    color: var(--color-accent-dark);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-right: var(--space-2);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__media-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-hero__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-card-hover);
  }

  .home-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .home-hero__media-caption {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .home-hero {
      padding: var(--space-8) 0;
    }

    .home-hero__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-6);
    }

    .home-hero__media-wrapper {
      height: 100%;
      margin-top: 0;
    }

    .home-hero__media {
      height: auto;
      aspect-ratio: 1 / 1.05;
    }
  }

  @media (min-width: 1180px) {
    .home-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: center;
    }

    .home-hero__media {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .home-hero__media-wrapper {
      margin-top: 0;
    }
  }

  @media (min-width: 1440px) {
    .home-hero h1 {
      max-width: 14.5ch;
      font-size: 5.2rem;
    }

    .home-hero h1.is-kannada {
      max-width: 100%;
      font-size: 3.8rem;
    }
  }

  @media (max-width: 420px) {
    .home-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
