---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
import { Image } from 'astro:assets';

const { hero } = home;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Container>
    <div class="home-hero__grid">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{hero.eyebrow}</p>
        <h1 id="home-hero-title">{hero.title}</h1>
        <p class="home-hero__kannada">{hero.kannadaLine}</p>
        <p class="home-hero__lead">{hero.description}</p>
        <p class="home-hero__phrase"><span>Focus:</span> {hero.phrase}</p>

        <div class="home-hero__actions" aria-label="Homepage actions">
          <Button href={hero.ctas[0].href} variant="primary">{hero.ctas[0].label}</Button>
          <Button href={hero.ctas[1].href} variant="outline">{hero.ctas[1].label}</Button>
        </div>
      </div>

      <div class="home-hero__media-wrapper">
        <div class="home-hero__media">
          <Image
            src={hero.media.image}
            alt={hero.media.alt}
            width={1200}
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="home-hero__proof" aria-label="Selected impact numbers">
            <p><strong>100+</strong><span>Trees planted</span></p>
            <p><strong>200+</strong><span>Students supported</span></p>
          </div>
        </div>
        <p class="home-hero__media-caption"><span aria-hidden="true"></span>{hero.media.label}</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 7.5rem) 0;
    background:
      radial-gradient(circle at 8% 12%, rgba(220, 166, 74, 0.13), transparent 24rem),
      var(--color-bg-warm);
  }

  .home-hero::after {
    position: absolute;
    right: -8rem;
    bottom: -12rem;
    width: 28rem;
    height: 28rem;
    border: 1px solid rgba(20, 87, 61, 0.1);
    border-radius: 50%;
    content: "";
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-7);
    position: relative;
    z-index: 1;
    align-items: center;
  }

  .home-hero__eyebrow {
    margin-bottom: var(--space-3);
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero__eyebrow::before {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px rgba(220, 166, 74, 0.14);
    content: "";
  }

  .home-hero h1 {
    max-width: 11ch;
    margin-bottom: var(--space-5);
    font-size: clamp(3rem, 6.4vw, 6.25rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .home-hero__lead {
    max-width: 35rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.75;
  }

  .home-hero__kannada {
    max-width: 44rem;
    color: var(--color-accent-dark);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .home-hero__phrase {
    margin-bottom: var(--space-6);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text);
    padding-left: var(--space-3);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .home-hero__phrase span {
    color: var(--color-accent-dark);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-right: var(--space-2);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__media-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-hero__media {
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: 0 4rem 0 4rem;
    border: 8px solid rgba(255, 255, 255, 0.76);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-lg);
  }

  .home-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .home-hero__proof {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-md);
    background: rgba(6, 43, 29, 0.92);
    backdrop-filter: blur(12px);
    color: #ffffff;
    box-shadow: var(--shadow-md);
  }

  .home-hero__proof p {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0.9rem 1rem;
  }

  .home-hero__proof p + p {
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .home-hero__proof strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
  }

  .home-hero__proof span {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-hero__media-caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .home-hero__media-caption span {
    width: 1.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  @media (min-width: 768px) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
      align-items: stretch;
    }

    .home-hero__media-wrapper {
      height: 100%;
      margin-top: 0;
    }

    .home-hero__media {
      height: clamp(470px, 50vw, 620px);
      aspect-ratio: auto;
    }
  }

  @media (min-width: 1180px) {
    .home-hero__grid {
      grid-template-columns: minmax(500px, 0.9fr) minmax(560px, 1.1fr);
      gap: var(--space-7);
    }

    .home-hero__media {
      height: clamp(560px, 44vw, 680px);
      aspect-ratio: auto;
    }

    .home-hero__media-wrapper {
      margin-top: 0;
    }
  }

  @media (min-width: 1440px) {
    .home-hero h1 {
      max-width: 14.5ch;
      font-size: 5.2rem;
    }
  }

  @media (max-width: 420px) {
    .home-hero__media {
      border-radius: 0 2.5rem 0 2.5rem;
    }

    .home-hero__proof {
      right: 0.6rem;
      bottom: 0.6rem;
    }

    .home-hero__proof p {
      padding: 0.7rem;
    }

    .home-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
