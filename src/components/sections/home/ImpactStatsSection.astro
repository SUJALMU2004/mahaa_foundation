---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import { home } from '../../../data/home';
---

<section class="impact-section" aria-labelledby="impact-title">
  <Container>
    <SectionHeader
      headingId="impact-title"
      eyebrow="Impact"
      title="Our Growing Impact"
      description="Every tree planted, every ration kit shared, and every volunteer hour brings us closer to a cleaner, kinder, and stronger community."
    />

    <div class="impact-grid">
      {
        home.impactStats.map((stat) => (
          <article class="impact-card">
            <strong>{stat.value}</strong>
            <h3>{stat.label}</h3>
            <p>{stat.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .impact-section {
    padding: var(--space-8) 0;
    background: var(--color-bg-soft);
  }

  .impact-grid {
    display: grid;
    gap: var(--space-4);
  }

  .impact-card {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5) var(--space-5) var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
    overflow: hidden;
  }

  .impact-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-primary);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .impact-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .impact-card strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .impact-card h3 {
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .impact-card p {
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .impact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-card {
      transition: none;
    }
    .impact-card:hover {
      transform: none;
    }
  }
</style>
