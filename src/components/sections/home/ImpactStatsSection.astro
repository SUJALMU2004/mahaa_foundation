---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import { home } from '../../../data/home';
---

<section class="impact-section" aria-labelledby="impact-title">
  <Container>
    <SectionHeader
      headingId="impact-title"
      eyebrow="Impact"
      title="Our Growing Impact"
      description="Every tree planted, every ration kit shared, and every volunteer hour brings us closer to a cleaner, kinder, and stronger community."
    />

    <div class="impact-grid">
      {
        home.impactStats.map((stat) => (
          <article class="impact-card">
            <strong>{stat.value}</strong>
            <h3>{stat.label}</h3>
            <p>{stat.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .impact-section {
    position: relative;
    overflow: hidden;
    padding: var(--space-8) 0;
    background: var(--color-primary-dark);
  }

  .impact-section::after {
    position: absolute;
    top: -10rem;
    right: -8rem;
    width: 24rem;
    height: 24rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    content: "";
  }

  .impact-section :global(.container) {
    position: relative;
    z-index: 1;
  }

  .impact-section :global(.section-header__eyebrow) {
    color: #efc979;
  }

  .impact-section :global(.section-header h2) {
    color: #ffffff;
  }

  .impact-section :global(.section-header__description) {
    color: rgba(255, 255, 255, 0.68);
  }

  .impact-grid {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .impact-card {
    position: relative;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0;
    background: transparent;
    padding: var(--space-5);
    box-shadow: none;
    transition: box-shadow var(--transition), transform var(--transition);
    overflow: hidden;
  }

  .impact-card:hover {
    background: rgba(255, 255, 255, 0.045);
    box-shadow: none;
    transform: none;
  }

  .impact-card strong {
    display: block;
    margin-bottom: var(--space-2);
    color: #efc979;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .impact-card h3 {
    margin-bottom: var(--space-2);
    color: #ffffff;
  }

  .impact-card p {
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact-card {
      border-right: 1px solid rgba(255, 255, 255, 0.14);
    }
  }

  @media (min-width: 1024px) {
    .impact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .impact-card {
      border-bottom: 0;
    }

    .impact-card:last-child {
      border-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-card {
      transition: none;
    }
    .impact-card:hover {
      transform: none;
    }
  }
</style>
