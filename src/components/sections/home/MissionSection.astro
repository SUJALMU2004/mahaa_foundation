---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { home } from '../../../data/home';
---

<section class="mission-section" aria-labelledby="mission-title">
  <Container>
    <div class="mission-section__intro">
      <p class="mission-section__eyebrow">Mission</p>
      <h2 id="mission-title">Serving People. Supporting Education. Growing Greener Communities.</h2>
      <p>
        Our mission is to serve communities in need through ration support, student assistance,
        health awareness, tree plantation, and volunteer-driven social service activities in
        Mahalingpur and nearby areas.
      </p>
      <Button href="/about" variant="outline">Learn About Our NGO</Button>
    </div>

    <div class="mission-grid">
      {
        home.missionCards.map((card, index) => (
          <article class="mission-card">
            <span class="mission-card__number" aria-hidden="true">0{index + 1}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .mission-section {
    padding: var(--space-9) 0;
    background: #ffffff;
  }

  .mission-section__intro {
    max-width: 760px;
    margin-bottom: var(--space-7);
  }

  .mission-section__intro p:not(.mission-section__eyebrow) {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .mission-section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mission-section__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .mission-grid {
    display: grid;
    gap: var(--space-4);
  }

  .mission-card {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    padding: var(--space-6);
    box-shadow: none;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .mission-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .mission-card__number {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .mission-card p {
    margin-bottom: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .mission-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission-card {
      transition: none;
    }
    .mission-card:hover {
      transform: none;
    }
  }
</style>
