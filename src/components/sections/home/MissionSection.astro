---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import { home } from '../../../data/home';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const { missionCards, missionSection } = home[lang];
---

<section class="mission-section" aria-labelledby="mission-title">
  <Container>
    <div class="mission-section__intro">
      <p class="mission-section__eyebrow">{missionSection.eyebrow}</p>
      <h2 id="mission-title">{missionSection.title}</h2>
      <p>{missionSection.description}</p>
      <Button href={translatePath('/about', lang)} variant="outline">{missionSection.btnLearnMore}</Button>
    </div>

    <div class="mission-grid">
      {
        missionCards.map((card, index) => (
          <article class="mission-card">
            <span class="mission-card__icon" aria-hidden="true"></span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .mission-section {
    padding: var(--space-8) 0;
  }

  .mission-section__intro {
    max-width: 760px;
    margin-bottom: var(--space-7);
  }

  .mission-section__intro p:not(.mission-section__eyebrow) {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .mission-section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mission-section__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .mission-grid {
    display: grid;
    gap: var(--space-4);
  }

  .mission-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .mission-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .mission-card__icon {
    display: block;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius);
    background: var(--gradient-primary);
    opacity: 0.9;
  }

  .mission-card p {
    margin-bottom: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .mission-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission-card {
      transition: none;
    }
    .mission-card:hover {
      transform: none;
    }
  }
</style>
