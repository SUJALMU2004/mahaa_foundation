---
import VolunteerEnquiryForm from '../../forms/VolunteerEnquiryForm.astro';
---

<section class="conversion-section">
  <div class="container conversion-section__inner">
    <VolunteerEnquiryForm />
  </div>
</section>

<style>
  .conversion-section {
    padding: var(--space-6) 0 var(--space-7);
    background:
      linear-gradient(180deg, var(--color-bg-soft), #ffffff);
  }

  .conversion-section__inner {
    max-width: 920px;
  }
</style>
