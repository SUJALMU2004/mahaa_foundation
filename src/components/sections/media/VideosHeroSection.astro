---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { site } from '../../../data/site';
---

<section class="videos-hero" aria-labelledby="videos-page-title">
  <Container>
    <div class="videos-hero__content">
      <p class="eyebrow">Videos</p>
      <h1 id="videos-page-title">NGO Activity Videos</h1>
      <p>
        Watch NGO videos from {site.city}, including tree plantation drives, ration distribution
        activities, student support, health support, awareness programs, volunteer work, and
        community welfare.
      </p>
      <div class="videos-hero__actions">
        <Button href="/gallery" variant="primary">View Gallery</Button>
        <Button href="/activities" variant="outline">View Activities</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .videos-hero {
    padding: var(--space-8) 0;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(15, 107, 69, 0.05), transparent 50%),
      #ffffff;
  }

  .videos-hero__content {
    max-width: 860px;
  }

  .videos-hero p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .videos-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
