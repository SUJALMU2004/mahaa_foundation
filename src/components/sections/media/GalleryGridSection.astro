---
import Container from '../../common/Container.astro';
import MediaGrid from '../../media/MediaGrid.astro';
import type { GalleryItem } from '../../../data/media';
import { getLangFromUrl } from '../../../i18n/utils';

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const content = {
  en: {
    eyebrow: 'Activity Proof',
    title: 'Photos from NGO Activities',
    description: 'Browse photo moments from tree plantation, ration distribution, student support, health support, social service, awareness, and volunteer activities.',
  },
  kn: {
    eyebrow: 'ಚಟುವಟಿಕೆ ಸಾಕ್ಷ್ಯ',
    title: 'ಎನ್‌ಜಿಒ ಚಟುವಟಿಕೆಗಳ ಫೋಟೋಗಳು',
    description: 'ಮರ ನೆಡುವಿಕೆ, ರೇಷನ್ ವಿತರಣೆ, ವಿದ್ಯಾರ್ಥಿ ಬೆಂಬಲ, ಆರೋಗ್ಯ ಬೆಂಬಲ, ಸಮಾಜ ಸೇವೆ, ಜಾಗೃತಿ ಮತ್ತು ಸ್ವಯಂಸೇವಕ ಚಟುವಟಿಕೆಗಳಿಂದ ಫೋಟೋ ಕ್ಷಣಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ.',
  }
};
const t = content[lang];
---

<section class="gallery-grid-section" aria-labelledby="gallery-grid-title">
  <Container>
    <div class="gallery-grid-section__header">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="gallery-grid-title">{t.title}</h2>
        <p>{t.description}</p>
      </div>
    </div>
    <MediaGrid items={items} />
  </Container>
</section>

<style>
  .gallery-grid-section {
    padding: var(--space-8) 0 var(--space-9);
    background: #ffffff;
  }

  .gallery-grid-section__header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    max-width: 820px;
  }

  .gallery-grid-section__header p:not(.eyebrow) {
    max-width: 760px;
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
