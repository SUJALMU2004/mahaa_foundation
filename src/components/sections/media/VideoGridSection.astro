---
import Container from '../../common/Container.astro';
import MediaCategoryPills from '../../media/MediaCategoryPills.astro';
import VideoCard from '../../media/VideoCard.astro';
import type { MediaCategory, VideoItem } from '../../../data/media';

export interface Props {
  categories: MediaCategory[];
  videos: VideoItem[];
}

const { categories, videos } = Astro.props;
const featuredVideo = videos[0];
---

<section class="video-grid-section" aria-labelledby="video-grid-title">
  <Container>
    {
      featuredVideo && (
        <div class="video-grid-section__featured" aria-labelledby="featured-video-title">
          <div class="video-grid-section__featured-content">
            <p class="eyebrow">Featured Video</p>
            <h2 id="featured-video-title">{featuredVideo.title}</h2>
            <p>{featuredVideo.description}</p>
          </div>
          <div class="video-grid-section__featured-card">
            <VideoCard
              title={featuredVideo.title}
              description={featuredVideo.description}
              category={featuredVideo.category}
              poster={featuredVideo.poster}
              videoSrc={featuredVideo.videoSrc}
              duration={featuredVideo.duration}
              relatedHref={featuredVideo.relatedHref}
              videoAltText={featuredVideo.videoAltText}
            />
          </div>
        </div>
      )
    }

    <div class="video-grid-section__header">
      <div>
        <p class="eyebrow">Video Library</p>
        <h2 id="video-grid-title">Mahaa Foundation Activity Videos</h2>
        <p>
          Watch local videos from tree plantation, student support, health support, awareness,
          and social service activities.
        </p>
      </div>
      <MediaCategoryPills categories={categories} ariaLabel="Video category links" />
    </div>
    <div class="video-grid-section__grid">
      {
        videos.map((video) => (
          <VideoCard
            title={video.title}
            description={video.description}
            category={video.category}
            poster={video.poster}
            videoSrc={video.videoSrc}
            duration={video.duration}
            relatedHref={video.relatedHref}
            videoAltText={video.videoAltText}
          />
        ))
      }
    </div>
  </Container>
</section>

<style>
  .video-grid-section {
    padding: var(--space-8) 0;
  }

  .video-grid-section__featured {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(230, 244, 236, 0.7), rgba(255, 248, 234, 0.6)),
      #ffffff;
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .video-grid-section__featured-content p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .video-grid-section__header p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .video-grid-section__header {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .video-grid-section__grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 760px) {
    .video-grid-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .video-grid-section__featured {
      grid-template-columns: minmax(0, 0.85fr) minmax(420px, 1.15fr);
      align-items: center;
    }

    .video-grid-section__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
