---
import Container from '../../common/Container.astro';
import ActivityCard from '../../media/ActivityCard.astro';
import type { ActivityItem } from '../../../data/activities';

export interface Props {
  activities: ActivityItem[];
  featured?: ActivityItem;
}

const { activities, featured } = Astro.props;
---

<section class="activities-grid-section" aria-labelledby="activities-grid-title">
  <Container>
    {
      featured && (
        <div class="activities-grid-section__featured">
          <div>
            <p class="eyebrow">Featured Activity</p>
            <h2>{featured.title}</h2>
            <p>{featured.description}</p>
            <a href={`/activities/${featured.slug}`}>View featured activity</a>
          </div>
          <ActivityCard
            title={featured.title}
            description={featured.description}
            href={`/activities/${featured.slug}`}
            category={featured.category}
            date={featured.date}
            dateLabel={featured.dateLabel}
            location={featured.location}
            image={featured.image}
            imageAlt={featured.imageAlt}
            variant="modern"
          />
        </div>
      )
    }

    <div class="activities-grid-section__header">
      <div>
        <p class="eyebrow">Activity Updates</p>
        <h2 id="activities-grid-title">Recent and Upcoming Activity Pages</h2>
        <p>
          These static activity pages are ready for verified photos, videos, dates, and location
          details when real activity proof is available.
        </p>
      </div>
    </div>

    <div class="activity-grid">
      {
        activities.map((activity) => (
          <ActivityCard
            title={activity.title}
            description={activity.description}
            href={`/activities/${activity.slug}`}
            category={activity.category}
            date={activity.date}
            dateLabel={activity.dateLabel}
            location={activity.location}
            image={activity.image}
            imageAlt={activity.imageAlt}
            variant="modern"
          />
        ))
      }
    </div>
  </Container>
</section>

<style>
  .activities-grid-section {
    padding: var(--space-7) 0;
    background: #ffffff;
  }

  .activities-grid-section__featured {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, rgb(232 243 235 / 0.72), rgb(255 248 237 / 0.76)),
      #ffffff;
    padding: var(--space-5);
    box-shadow: 0 18px 48px rgb(23 35 29 / 0.07);
  }

  .activities-grid-section__featured p:not(.eyebrow),
  .activities-grid-section__header p:not(.eyebrow) {
    color: var(--color-muted);
  }

  .activities-grid-section__featured a {
    color: var(--color-primary-dark);
    font-weight: 900;
    text-underline-offset: 0.18em;
  }

  .activities-grid-section__featured a:hover,
  .activities-grid-section__featured a:focus-visible {
    color: var(--color-primary);
  }

  .activities-grid-section__header {
    display: grid;
    max-width: 800px;
    margin-bottom: var(--space-6);
  }

  .activity-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 760px) {
    .activity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .activities-grid-section__featured {
      grid-template-columns: minmax(0, 0.8fr) minmax(420px, 1.2fr);
      align-items: center;
    }

    .activity-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
