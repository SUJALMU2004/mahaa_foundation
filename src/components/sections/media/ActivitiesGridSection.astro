---
import Container from '../../common/Container.astro';
import ActivityCard from '../../media/ActivityCard.astro';
import type { ActivityItem } from '../../../data/activities';

export interface Props {
  activities: ActivityItem[];
  featured?: ActivityItem;
}

const { activities, featured } = Astro.props;
---

<section class="activities-grid-section" aria-labelledby="activities-grid-title">
  <Container>
    {
      featured && (
        <div class="activities-grid-section__featured">
          <div class="activities-grid-section__featured-content">
            <p class="eyebrow">Featured Activity</p>
            <h2>{featured.title}</h2>
            <p>{featured.description}</p>
            <a href={`/activities/${featured.slug}`}>View featured activity</a>
          </div>
          <div class="activities-grid-section__featured-card">
            <ActivityCard
              title={featured.title}
              description={featured.description}
              href={`/activities/${featured.slug}`}
              category={featured.category}
              date={featured.date}
              dateLabel={featured.dateLabel}
              location={featured.location}
              image={featured.image}
              imageAlt={featured.imageAlt}
              variant="modern"
            />
          </div>
        </div>
      )
    }

    <div class="activities-grid-section__header">
      <div>
        <p class="eyebrow">Activity Updates</p>
        <h2 id="activities-grid-title">Recent and Upcoming Activity Pages</h2>
        <p>
          These static activity pages are ready for verified photos, videos, dates, and location
          details when real activity proof is available.
        </p>
      </div>
    </div>

    <div class="activity-grid">
      {
        activities.map((activity) => (
          <ActivityCard
            title={activity.title}
            description={activity.description}
            href={`/activities/${activity.slug}`}
            category={activity.category}
            date={activity.date}
            dateLabel={activity.dateLabel}
            location={activity.location}
            image={activity.image}
            imageAlt={activity.imageAlt}
            variant="modern"
          />
        ))
      }
    </div>
  </Container>
</section>

<style>
  .activities-grid-section {
    padding: var(--space-8) 0;
    background: #ffffff;
  }

  .activities-grid-section__featured {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(230, 244, 236, 0.7), rgba(255, 248, 234, 0.6)),
      #ffffff;
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .activities-grid-section__featured-content p:not(.eyebrow),
  .activities-grid-section__header p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .activities-grid-section__featured a:not(.activity-card__link) {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    text-underline-offset: 0.22em;
    transition: color var(--transition);
  }

  .activities-grid-section__featured a:not(.activity-card__link):hover,
  .activities-grid-section__featured a:not(.activity-card__link):focus-visible {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .activities-grid-section__header {
    display: grid;
    max-width: 800px;
    margin-bottom: var(--space-7);
  }

  .activity-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 760px) {
    .activity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .activities-grid-section__featured {
      grid-template-columns: minmax(0, 0.85fr) minmax(420px, 1.15fr);
      align-items: center;
    }

    .activity-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
