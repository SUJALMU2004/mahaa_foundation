---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { site } from '../../../data/site';
import galleryHeroImage from '../../../assets/inner/gallery-hero.png';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const content = {
  en: {
    eyebrow: 'Gallery',
    title: 'Mahaa Foundation Gallery',
    description: `Explore photos and videos from our tree plantation drives, ration distribution activities, student support, health support, awareness work, volunteer service, and community welfare initiatives in ${site.city}.`,
    btnVolunteer: 'Join as Volunteer',
    btnActivities: 'View Activities',
  },
  kn: {
    eyebrow: 'ಗ್ಯಾಲರಿ',
    title: 'ಮಹಾ ಫೌಂಡೇಶನ್ ಗ್ಯಾಲರಿ',
    description: `${site.city}ಯಲ್ಲಿ ನಮ್ಮ ಮರ ನೆಡುವಿಕೆ ಅಭಿಯಾನಗಳು, ರೇಷನ್ ವಿತರಣೆ ಚಟುವಟಿಕೆಗಳು, ವಿದ್ಯಾರ್ಥಿ ಬೆಂಬಲ, ಆರೋಗ್ಯ ಬೆಂಬಲ, ಜಾಗೃತಿ ಕಾರ್ಯ, ಸ್ವಯಂಸೇವಕ ಸೇವೆ ಮತ್ತು ಸಮುದಾಯ ಕಲ್ಯಾಣ ಉಪಕ್ರಮಗಳ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಅನ್ವೇಷಿಸಿ.`,
    btnVolunteer: 'ಸ್ವಯಂಸೇವಕರಾಗಿ',
    btnActivities: 'ಚಟುವಟಿಕೆಗಳನ್ನು ವೀಕ್ಷಿಸಿ',
  }
};
const t = content[lang];
---

<section class="media-hero" aria-labelledby="gallery-page-title">
  <Container>
    <div class="media-hero__grid">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="gallery-page-title">{t.title}</h1>
        <p class="media-hero__description">{t.description}</p>
        <div class="media-hero__actions">
          <Button href={translatePath('/volunteer', lang)} variant="primary">{t.btnVolunteer}</Button>
          <Button href={translatePath('/activities', lang)} variant="outline">{t.btnActivities}</Button>
        </div>
      </div>
      <div class="media-hero__panel">
        <Image
          src={galleryHeroImage}
          alt="Mahaa Foundation Mahalingpur gallery activity moment"
          width={900}
          format="webp"
          quality={82}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .media-hero {
    padding: var(--space-8) 0;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(15, 107, 69, 0.05), transparent 50%),
      #ffffff;
  }

  .media-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .media-hero__description {
    max-width: 760px;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .media-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .media-hero__panel {
    display: block;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-md);
  }

  .media-hero__panel :global(img) {
    display: block;
    width: 100%;
    min-height: 320px;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 900px) {
    .media-hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    }
  }
</style>
