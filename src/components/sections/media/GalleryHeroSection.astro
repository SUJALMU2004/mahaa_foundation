---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import { site } from '../../../data/site';
---

<section class="media-hero" aria-labelledby="gallery-page-title">
  <Container>
    <div class="media-hero__grid">
      <div>
        <p class="eyebrow">Gallery</p>
        <h1 id="gallery-page-title">NGO Activity Gallery</h1>
        <p class="media-hero__description">
          Explore photos and videos from our tree plantation drives, ration distribution activities,
          student support, health support, awareness work, volunteer service, and community welfare
          initiatives in {site.city}.
        </p>
        <div class="media-hero__actions">
          <Button href="/volunteer" variant="primary">Join as Volunteer</Button>
          <Button href="/activities" variant="outline">View Activities</Button>
        </div>
      </div>
      <div class="media-hero__panel" aria-label="Gallery media proof placeholder">
        <span>Photos</span>
        <span>Videos</span>
        <span>Activities</span>
      </div>
    </div>
  </Container>
</section>

<style>
  .media-hero {
    padding: var(--space-8) 0;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(15, 107, 69, 0.05), transparent 50%),
      #ffffff;
  }

  .media-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .media-hero__description {
    max-width: 760px;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .media-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .media-hero__panel {
    display: grid;
    min-height: 320px;
    align-content: end;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(15, 107, 69, 0.12), rgba(214, 166, 74, 0.08)),
      var(--color-bg-soft);
    box-shadow: var(--shadow-md);
    padding: var(--space-5);
  }

  .media-hero__panel span {
    width: fit-content;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    color: var(--color-primary-dark);
    padding: 0.55rem 0.85rem;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-xs);
  }

  @media (min-width: 900px) {
    .media-hero__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    }
  }
</style>
