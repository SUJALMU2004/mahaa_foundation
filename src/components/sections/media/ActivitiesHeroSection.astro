---
import Container from '../../common/Container.astro';
---

<section class="activities-hero" aria-labelledby="activities-page-title">
  <Container>
    <div class="activities-hero__content">
      <p class="eyebrow">Activities and Events</p>
      <h1 id="activities-page-title">Mahaa Foundation Activities</h1>
      <p>
        Stay connected with our NGO activities, including tree plantation drives, ration
        distribution programs, student support, health support, cleanliness awareness,
        plastic-free awareness, social service work, and volunteer-led community initiatives.
      </p>
    </div>
  </Container>
</section>

<style>
  .activities-hero {
    padding: var(--space-8) 0;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(15, 107, 69, 0.05), transparent 50%),
      #ffffff;
  }

  .activities-hero__content {
    max-width: 840px;
  }

  .activities-hero p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }
</style>
