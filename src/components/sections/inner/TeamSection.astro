---
import Container from '../../common/Container.astro';
import { founder, teamMembers } from '../../../data/team';

export interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const allMembers = [founder, ...teamMembers];
const {
  eyebrow = 'Founder and Team',
  title = 'People Behind Mahaa Foundation Mahalingpur',
  description =
    'Mahaa Foundation Mahalingpur is led by founder Anilkumar Ullagaddi with a local team supporting service, education, health awareness, and community welfare activities.',
} = Astro.props;
---

<section class="team-section" aria-labelledby="team-section-title">
  <Container>
    <div class="team-section__header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="team-section-title">{title}</h2>
      <p>{description}</p>
    </div>

    <div class="team-grid">
      {
        allMembers.map((member) => {
          const initials = member.name
            .split(' ')
            .map((part) => part[0])
            .join('')
            .slice(0, 2);

          return (
            <article class={`team-card ${member.role === 'Founder' ? 'team-card--founder' : ''}`}>
              <div
                class:list={['team-card__media', member.image ? 'has-image' : 'has-placeholder']}
                role={!member.image ? 'img' : undefined}
                aria-label={!member.image ? member.imageAlt : undefined}
              >
                {member.image ? (
                  <img
                    src={member.image}
                    alt={member.imageAlt}
                    width="640"
                    height="640"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span>{initials}</span>
                )}
              </div>
              <div class="team-card__body">
                <p>{member.role}</p>
                <h3>{member.name}</h3>
                <p>{member.description}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .team-section {
    padding: var(--space-7) 0;
    background: #ffffff;
  }

  .team-section__header {
    max-width: 820px;
    margin-bottom: var(--space-5);
  }

  .team-section__header p:not(.eyebrow) {
    color: var(--color-muted);
  }

  .team-grid {
    display: grid;
    align-items: stretch;
    gap: var(--space-4);
  }

  .team-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .team-card:hover {
    border-color: rgb(23 107 58 / 0.28);
    box-shadow: 0 14px 34px rgb(23 35 29 / 0.08);
    transform: translateY(-3px);
  }

  .team-card__media {
    display: grid;
    height: 240px;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: #f7f8f5;
  }

  .team-card__media.has-image {
    background: #ffffff;
  }

  .team-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
  }

  .team-card__media span {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-primary-dark);
    font-weight: 900;
  }

  .team-card__body {
    flex: 1;
    padding: var(--space-4);
  }

  .team-card__body p:first-child {
    margin-bottom: var(--space-2);
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .team-card__body p:last-child {
    color: var(--color-muted);
  }

  @media (min-width: 700px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .team-card__media {
      height: 250px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card {
      transition: none;
    }

    .team-card:hover {
      transform: none;
    }
  }
</style>
