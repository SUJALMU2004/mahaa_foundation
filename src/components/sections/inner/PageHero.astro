---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import type { CtaLink } from '../../../data/pages';
import { whatsappUrl } from '../../../utils/seo';

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  image: string;
  imageAlt: string;
  hideActions?: boolean;
  hideMedia?: boolean;
  variant?: 'default' | 'modern';
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
  hideActions = false,
  hideMedia = false,
  variant = 'default',
} = Astro.props;

function resolveHref(cta: CtaLink) {
  return cta.href === 'whatsapp' ? whatsappUrl() : cta.href;
}
---

<section class:list={['page-hero', `page-hero--${variant}`]} aria-labelledby="page-title">
  <Container>
    <div class="page-hero__grid">
      <div class="page-hero__content">
        <p class="page-hero__eyebrow">{eyebrow}</p>
        <h1 id="page-title">{title}</h1>
        <p class="page-hero__description">{description}</p>
        {
          !hideActions && (
            <div class="page-hero__actions">
              <Button
                href={resolveHref(primaryCta)}
                variant={primaryCta.variant ?? 'primary'}
                external={primaryCta.external ?? primaryCta.href === 'whatsapp'}
              >
                {primaryCta.label}
              </Button>
              <Button
                href={resolveHref(secondaryCta)}
                variant={secondaryCta.variant ?? 'outline'}
                external={secondaryCta.external ?? secondaryCta.href === 'whatsapp'}
              >
                {secondaryCta.label}
              </Button>
            </div>
          )
        }
      </div>

      {
        !hideMedia && (
          <div
            class="page-hero__media"
            role="img"
            aria-label={imageAlt}
            data-image={image}
            style={`--hero-image: url("${image}")`}
          >
            <span>Future image area</span>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    padding: var(--space-7) 0;
    background:
      radial-gradient(circle at top left, rgb(232 243 235 / 0.9), transparent 30rem),
      #ffffff;
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .page-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-hero__description {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .page-hero__media {
    display: grid;
    min-height: 280px;
    aspect-ratio: 4 / 3;
    place-items: end start;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, rgb(23 107 58 / 0.15), rgb(217 140 36 / 0.12)),
      repeating-linear-gradient(
        135deg,
        rgb(255 255 255 / 0.72) 0 14px,
        rgb(23 107 58 / 0.07) 14px 28px
      ),
      var(--color-primary-soft);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
  }

  .page-hero--modern {
    background:
      linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);
  }

  .page-hero--modern .page-hero__grid {
    align-items: stretch;
  }

  .page-hero--modern .page-hero__content {
    display: grid;
    align-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    padding: var(--space-6);
    box-shadow: 0 18px 44px rgb(23 35 29 / 0.07);
  }

  .page-hero--modern .page-hero__description {
    max-width: 44rem;
  }

  .page-hero--modern .page-hero__grid:has(.page-hero__content:only-child) {
    max-width: 920px;
  }

  .page-hero--modern .page-hero__media {
    min-height: 340px;
    background:
      linear-gradient(135deg, rgb(23 107 58 / 0.18), rgb(217 140 36 / 0.1)),
      var(--hero-image),
      var(--color-bg-soft);
    background-position: center;
    background-size: cover;
  }

  .page-hero__media span {
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.9);
    color: var(--color-primary-dark);
    padding: 0.65rem 0.85rem;
    font-weight: 900;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: var(--space-8) 0;
    }

    .page-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    }

    .page-hero__grid:has(.page-hero__content:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .page-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
