---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import type { CtaLink } from '../../../data/pages';
import { whatsappUrl } from '../../../utils/seo';
import type { ImageMetadata } from 'astro';

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  image: string | ImageMetadata;
  imageAlt: string;
  hideActions?: boolean;
  hideMedia?: boolean;
  variant?: 'default' | 'modern';
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
  hideActions = false,
  hideMedia = false,
  variant = 'default',
} = Astro.props;

function resolveHref(cta: CtaLink) {
  return cta.href === 'whatsapp' ? whatsappUrl() : cta.href;
}
---

<section class:list={['page-hero', `page-hero--${variant}`]} aria-labelledby="page-title">
  <Container>
    <div class="page-hero__grid">
      <div class="page-hero__content">
        <p class="page-hero__eyebrow">{eyebrow}</p>
        <h1 id="page-title">{title}</h1>
        <p class="page-hero__description">{description}</p>
        {
          !hideActions && (
            <div class="page-hero__actions">
              <Button
                href={resolveHref(primaryCta)}
                variant={primaryCta.variant ?? 'primary'}
                external={primaryCta.external ?? primaryCta.href === 'whatsapp'}
              >
                {primaryCta.label}
              </Button>
              <Button
                href={resolveHref(secondaryCta)}
                variant={secondaryCta.variant ?? 'outline'}
                external={secondaryCta.external ?? secondaryCta.href === 'whatsapp'}
              >
                {secondaryCta.label}
              </Button>
            </div>
          )
        }
      </div>

      {
        !hideMedia && (
          <div
            class="page-hero__media"
            role="img"
            aria-label={imageAlt}
            data-image={typeof image === 'string' ? image : image?.src}
            style={`--hero-image: url("${typeof image === 'string' ? image : image?.src}")`}
          >
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    padding: var(--space-8) 0;
    background: var(--color-bg);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .page-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-hero__description {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .page-hero__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-image:
      var(--hero-image),
      linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    background-position: center;
    background-size: cover;
  }

  /* Modern variant (consistent visual rhythm without boxed layouts) */
  .page-hero--modern {
    background: var(--color-bg-soft);
  }

  .page-hero--modern .page-hero__content {
    display: grid;
    align-content: center;
    padding: 0;
  }

  .page-hero--modern .page-hero__description {
    max-width: 44rem;
  }

  .page-hero--modern .page-hero__media {
    min-height: 340px;
    background-image:
      var(--hero-image),
      linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    background-position: center;
    background-size: cover;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: var(--space-9) 0;
    }

    .page-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    }

    .page-hero__grid:has(.page-hero__content:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .page-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
