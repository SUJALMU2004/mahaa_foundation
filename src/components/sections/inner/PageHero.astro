---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
import type { CtaLink } from '../../../data/pages';
import { whatsappUrl } from '../../../utils/seo';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: CtaLink;
  secondaryCta: CtaLink;
  image: string | ImageMetadata;
  imageAlt: string;
  hideActions?: boolean;
  hideMedia?: boolean;
  variant?: 'default' | 'modern';
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
  hideActions = false,
  hideMedia = false,
  variant = 'default',
} = Astro.props;

const hasOptimizedImage = typeof image !== 'string';

function resolveHref(cta: CtaLink) {
  return cta.href === 'whatsapp' ? whatsappUrl() : cta.href;
}
---

<section class:list={['page-hero', `page-hero--${variant}`]} aria-labelledby="page-title">
  <Container>
    <div class="page-hero__grid">
      <div class="page-hero__content">
        <p class="page-hero__eyebrow">{eyebrow}</p>
        <h1 id="page-title">{title}</h1>
        <p class="page-hero__description">{description}</p>
        {
          !hideActions && (
            <div class="page-hero__actions">
              <Button
                href={resolveHref(primaryCta)}
                variant={primaryCta.variant ?? 'primary'}
                external={primaryCta.external ?? primaryCta.href === 'whatsapp'}
              >
                {primaryCta.label}
              </Button>
              <Button
                href={resolveHref(secondaryCta)}
                variant={secondaryCta.variant ?? 'outline'}
                external={secondaryCta.external ?? secondaryCta.href === 'whatsapp'}
              >
                {secondaryCta.label}
              </Button>
            </div>
          )
        }
      </div>

      {
        !hideMedia && hasOptimizedImage && (
          <div class="page-hero__media">
            <Image
              src={image}
              alt={imageAlt}
              width={900}
              format="webp"
              quality={82}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }

      {
        !hideMedia && !hasOptimizedImage && (
          <div
            class="page-hero__media"
            role="img"
            aria-label={imageAlt}
            data-image={image}
            style={`--hero-image: url("${image}")`}
          >
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-8) 0;
    background:
      radial-gradient(circle at 8% 10%, rgba(220, 166, 74, 0.12), transparent 22rem),
      var(--color-bg-warm);
  }

  .page-hero::after {
    position: absolute;
    right: -9rem;
    bottom: -12rem;
    width: 26rem;
    height: 26rem;
    border: 1px solid rgba(20, 87, 61, 0.1);
    border-radius: 50%;
    content: "";
  }

  .page-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .page-hero__eyebrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-hero__eyebrow::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px rgba(220, 166, 74, 0.13);
    content: "";
  }

  .page-hero h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .page-hero__description {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .page-hero__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border: 8px solid rgba(255, 255, 255, 0.75);
    border-radius: 0 3.5rem 0 3.5rem;
    background-image:
      var(--hero-image),
      linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-lg);
  }

  .page-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Modern variant (consistent visual rhythm without boxed layouts) */
  .page-hero--modern {
    background:
      radial-gradient(circle at 8% 10%, rgba(220, 166, 74, 0.12), transparent 22rem),
      var(--color-bg-warm);
  }

  .page-hero--modern .page-hero__content {
    display: grid;
    align-content: center;
    padding: 0;
  }

  .page-hero--modern .page-hero__description {
    max-width: 44rem;
  }

  .page-hero--modern .page-hero__media {
    min-height: 340px;
    background-image:
      var(--hero-image),
      linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    background-position: center;
    background-size: cover;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: var(--space-9) 0;
    }

    .page-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    }

    .page-hero__grid:has(.page-hero__content:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .page-hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
