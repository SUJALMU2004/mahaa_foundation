---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import type { FeatureItem } from '../../../data/pages';

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: readonly FeatureItem[];
  variant?: 'default' | 'soft' | 'work-modern' | 'contact-modern';
}

const { eyebrow, title, description, items, variant = 'soft' } = Astro.props;
const headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section class:list={['feature-section', `feature-section--${variant}`]} aria-labelledby={headingId}>
  <Container>
    <SectionHeader eyebrow={eyebrow} title={title} description={description} headingId={headingId} />
    <div class="feature-grid">
      {
        items.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.href && item.linkLabel && <a href={item.href}>{item.linkLabel}</a>}
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .feature-section {
    padding: var(--space-8) 0;
  }

  .feature-section--soft {
    background: var(--color-bg-soft);
  }

  .feature-section--work-modern {
    background: linear-gradient(180deg, var(--color-bg-soft), #ffffff);
  }

  .feature-section--contact-modern {
    background: #ffffff;
  }

  .feature-grid {
    display: grid;
    gap: var(--space-4);
  }

  .feature-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
  }

  /* Work modern variant */
  .feature-section--work-modern .feature-grid {
    counter-reset: work-card;
    gap: var(--space-5);
  }

  .feature-section--contact-modern .feature-grid {
    gap: var(--space-5);
  }

  .feature-section--work-modern .feature-card,
  .feature-section--contact-modern .feature-card {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
  }

  .feature-section--work-modern .feature-card:hover,
  .feature-section--contact-modern .feature-card:hover {
    border-color: rgba(15, 107, 69, 0.2);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .feature-section--work-modern .feature-card::before {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    margin-bottom: var(--space-4);
    border: 1px solid rgba(15, 107, 69, 0.15);
    border-radius: var(--radius);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    content: counter(work-card, decimal-leading-zero);
    counter-increment: work-card;
    font-size: 0.82rem;
    font-weight: 800;
  }

  /* Heading accent bars */
  .feature-card h3 {
    position: relative;
    padding-top: var(--space-5);
  }

  .feature-section--work-modern .feature-card h3,
  .feature-section--contact-modern .feature-card h3 {
    padding-top: 0;
  }

  .feature-card h3::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 3px;
    border-radius: 999px;
    background: var(--gradient-accent);
    content: "";
  }

  .feature-section--work-modern .feature-card h3::before,
  .feature-section--contact-modern .feature-card h3::before {
    content: none;
  }

  .feature-card p {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .feature-section--work-modern .feature-card p,
  .feature-section--contact-modern .feature-card p {
    flex: 1;
  }

  .feature-card a {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .feature-card a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .feature-section--work-modern .feature-card a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin-top: var(--space-3);
    border-bottom: 2px solid transparent;
  }

  .feature-section--contact-modern .feature-card a {
    display: inline-flex;
    width: fit-content;
    margin-top: var(--space-3);
  }

  .feature-section--work-modern .feature-card a:hover {
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  .feature-card a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (min-width: 760px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-section--work-modern .feature-card,
    .feature-section--contact-modern .feature-card {
      transition: none;
    }
    .feature-section--work-modern .feature-card:hover,
    .feature-section--contact-modern .feature-card:hover {
      transform: none;
    }
  }
</style>
