---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import type { FeatureItem } from '../../../data/pages';

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: readonly FeatureItem[];
  variant?: 'default' | 'soft' | 'work-modern' | 'contact-modern';
}

const { eyebrow, title, description, items, variant = 'soft' } = Astro.props;
const headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section class:list={['feature-section', `feature-section--${variant}`]} aria-labelledby={headingId}>
  <Container>
    <SectionHeader eyebrow={eyebrow} title={title} description={description} headingId={headingId} />
    <div class="feature-grid">
      {
        items.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.href && item.linkLabel && <a href={item.href}>{item.linkLabel}</a>}
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .feature-section {
    padding: var(--space-7) 0;
  }

  .feature-section--soft {
    background: var(--color-bg-soft);
  }

  .feature-section--work-modern {
    background:
      linear-gradient(180deg, var(--color-bg-soft), #ffffff);
  }

  .feature-section--contact-modern {
    background: #ffffff;
  }

  .feature-grid {
    display: grid;
    gap: var(--space-4);
  }

  .feature-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    padding: var(--space-5);
  }

  .feature-section--work-modern .feature-grid {
    counter-reset: work-card;
    gap: var(--space-5);
  }

  .feature-section--contact-modern .feature-grid {
    gap: var(--space-5);
  }

  .feature-section--work-modern .feature-card {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    padding: var(--space-5);
    box-shadow: 0 12px 30px rgb(23 35 29 / 0.05);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .feature-section--contact-modern .feature-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    border-color: rgb(23 107 58 / 0.16);
    box-shadow: 0 10px 28px rgb(23 35 29 / 0.05);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .feature-section--contact-modern .feature-card:hover {
    border-color: rgb(23 107 58 / 0.3);
    box-shadow: 0 18px 42px rgb(23 35 29 / 0.09);
    transform: translateY(-3px);
  }

  .feature-section--work-modern .feature-card:hover {
    border-color: rgb(23 107 58 / 0.3);
    box-shadow: 0 18px 42px rgb(23 35 29 / 0.09);
    transform: translateY(-3px);
  }

  .feature-section--work-modern .feature-card::before {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    margin-bottom: var(--space-4);
    border: 1px solid rgb(23 107 58 / 0.18);
    border-radius: var(--radius);
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    content: counter(work-card, decimal-leading-zero);
    counter-increment: work-card;
    font-size: 0.84rem;
    font-weight: 900;
  }

  .feature-card h3 {
    position: relative;
    padding-top: var(--space-5);
  }

  .feature-section--work-modern .feature-card h3 {
    padding-top: 0;
  }

  .feature-section--contact-modern .feature-card h3 {
    padding-top: 0;
  }

  .feature-card h3::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 38px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-accent);
    content: "";
  }

  .feature-section--work-modern .feature-card h3::before {
    content: none;
  }

  .feature-section--contact-modern .feature-card h3::before {
    content: none;
  }

  .feature-card p {
    color: var(--color-muted);
  }

  .feature-section--work-modern .feature-card p {
    flex: 1;
  }

  .feature-section--contact-modern .feature-card p {
    flex: 1;
  }

  .feature-card a {
    color: var(--color-primary-dark);
    font-weight: 900;
    text-decoration: none;
  }

  .feature-card a:hover {
    text-decoration: underline;
  }

  .feature-section--work-modern .feature-card a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    margin-top: var(--space-3);
    border-bottom: 2px solid transparent;
  }

  .feature-section--contact-modern .feature-card a {
    display: inline-flex;
    width: fit-content;
    margin-top: var(--space-3);
    text-underline-offset: 0.18em;
  }

  .feature-section--work-modern .feature-card a:hover {
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  .feature-section--contact-modern .feature-card a:hover {
    color: var(--color-primary);
  }

  .feature-card a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  @media (min-width: 760px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-section--work-modern .feature-card {
      transition: none;
    }

    .feature-section--contact-modern .feature-card {
      transition: none;
    }

    .feature-section--work-modern .feature-card:hover {
      transform: none;
    }

    .feature-section--contact-modern .feature-card:hover {
      transform: none;
    }
  }
</style>
