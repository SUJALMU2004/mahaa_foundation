---
import Container from '../../common/Container.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  content: string;
}

const { eyebrow, title, content } = Astro.props;
---

<section class="intro-section" aria-labelledby="intro-title">
  <Container>
    <div class="intro-section__inner">
      {eyebrow && <p class="intro-section__eyebrow">{eyebrow}</p>}
      <h2 id="intro-title">{title}</h2>
      <p>{content}</p>
    </div>
  </Container>
</section>

<style>
  .intro-section {
    padding: var(--space-7) 0;
  }

  .intro-section__inner {
    max-width: 820px;
  }

  .intro-section__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro-section p:not(.intro-section__eyebrow) {
    color: var(--color-muted);
    font-size: 1.08rem;
  }
</style>
