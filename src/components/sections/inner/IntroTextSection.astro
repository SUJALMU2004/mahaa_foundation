---
import Container from '../../common/Container.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  content: string;
}

const { eyebrow, title, content } = Astro.props;
---

<section class="intro-section" aria-labelledby="intro-title">
  <Container>
    <div class="intro-section__inner">
      {eyebrow && <p class="intro-section__eyebrow">{eyebrow}</p>}
      <h2 id="intro-title">{title}</h2>
      <p>{content}</p>
    </div>
  </Container>
</section>

<style>
  .intro-section {
    padding: var(--space-8) 0;
  }

  .intro-section__inner {
    max-width: 820px;
  }

  .intro-section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .intro-section__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .intro-section p:not(.intro-section__eyebrow) {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }
</style>
