---
import Container from '../../common/Container.astro';
import SectionHeader from '../../common/SectionHeader.astro';
import type { FeatureItem } from '../../../data/pages';

export interface Props {
  title: string;
  description?: string;
  steps: readonly FeatureItem[];
}

const { title, description, steps } = Astro.props;
const headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section class="process-section" aria-labelledby={headingId}>
  <Container>
    <SectionHeader title={title} description={description} headingId={headingId} />
    <div class="process-grid">
      {
        steps.map((step, index) => (
          <article class="process-step">
            <span class="process-step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .process-section {
    padding: var(--space-8) 0;
    background: var(--color-bg-soft);
  }

  .process-grid {
    display: grid;
    gap: var(--space-4);
  }

  .process-step {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    padding: var(--space-5);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .process-step:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .process-step__number {
    display: inline-flex;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .process-step p {
    margin-bottom: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (min-width: 760px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .process-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step {
      transition: none;
    }
    .process-step:hover {
      transform: none;
    }
  }
</style>
