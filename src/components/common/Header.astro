---
import Container from './Container.astro';
import Button from './Button.astro';
import LanguagePicker from './LanguagePicker.astro';
import {
  actionNavigation,
  primaryNavigation,
} from '../../data/navigation';
import { site } from '../../data/site';
import logoImage from '../../assets/logo/logo.png';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const currentPrimaryNav = primaryNavigation[lang];
const currentActionNav = actionNavigation[lang];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const translatedHref = translatePath(href, lang);
  const normalizedHref = translatedHref.replace(/\/$/, '') || '/';
  return normalizedHref === currentPath;
}
---

<header class="site-header">
  <Container class="site-header__inner">
    <a class="site-header__brand" href={translatePath('/', lang)} aria-label={`${site.siteName} home`}>
      <Image
        class="site-header__logo"
        src={logoImage}
        alt=""
        width={190}
        format="webp"
        quality={90}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="site-header__desktop-nav" aria-label="Primary navigation">
      {
        currentPrimaryNav.map((item) => (
          <a
            href={translatePath(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={['site-header__nav-link', isActive(item.href) && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <Button href={translatePath(currentActionNav[0].href, lang)} variant="outline" class="site-header__volunteer">
        {currentActionNav[0].label}
      </Button>
      <Button href={translatePath(currentActionNav[1].href, lang)} variant="primary">
        {currentActionNav[1].label}
      </Button>
      <LanguagePicker />
    </div>

    <details class="site-header__mobile-menu">
      <summary class="site-header__mobile-toggle">
        <span class="site-header__menu-icon" aria-hidden="true"></span>
        <span>Menu</span>
      </summary>

      <div class="site-header__mobile-panel" id="mobile-menu-panel">
        <Container>
          <nav class="site-header__mobile-nav" aria-label="Mobile primary navigation">
            <div class="site-header__mobile-group">
              <p class="site-header__mobile-label">Main Navigation</p>
              {
                currentPrimaryNav.map((item) => (
                  <a
                    href={translatePath(item.href, lang)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={['site-header__mobile-link', isActive(item.href) && 'is-active']}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>

            <div class="site-header__mobile-actions">
              <Button href={translatePath(currentActionNav[0].href, lang)} variant="outline">
                {currentActionNav[0].label}
              </Button>
              <Button href={translatePath(currentActionNav[1].href, lang)} variant="primary">
                {currentActionNav[1].label}
              </Button>
              <div style="margin-top: 1rem;">
                <LanguagePicker />
              </div>
            </div>
          </nav>
        </Container>
      </div>
    </details>
  </Container>
</header>
