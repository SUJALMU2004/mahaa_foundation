---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  headingId?: string;
}

const { eyebrow, title, description, align = 'left', headingId } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  {eyebrow && <p class="section-header__eyebrow">{eyebrow}</p>}
  <h2 id={headingId}>{title}</h2>
  {description && <p class="section-header__description">{description}</p>}
</div>
