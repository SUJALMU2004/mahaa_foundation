---
export interface Props {
  type: 'image' | 'video';
  label: string;
  image?: string;
  aspectRatio?: string;
  variant?: 'default' | 'clean';
}

const { type, label, image, aspectRatio = '4 / 3', variant = 'default' } = Astro.props;
---

<div
  class:list={['media-placeholder', `media-placeholder--${type}`, `media-placeholder--${variant}`]}
  role="img"
  aria-label={label}
  style={`--media-aspect: ${aspectRatio}; --media-image: ${image ? `url("${image}")` : 'none'};`}
>
  <span class="media-placeholder__mark" aria-hidden="true"></span>
  <span class="media-placeholder__label">{type === 'video' ? 'Video placeholder' : 'Image placeholder'}</span>
</div>

<style>
  .media-placeholder {
    display: grid;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--media-aspect);
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-image:
      linear-gradient(160deg, rgba(15, 107, 69, 0.14), rgba(214, 166, 74, 0.08)),
      var(--media-image),
      linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    background-position: center;
    background-size: cover;
  }

  .media-placeholder--clean {
    background-image:
      var(--media-image),
      linear-gradient(135deg, #f6faf7, #fff8ed);
    background-color: var(--color-bg-soft);
  }

  .media-placeholder--clean .media-placeholder__mark,
  .media-placeholder--clean .media-placeholder__label {
    display: none;
  }

  .media-placeholder__mark {
    width: 44px;
    height: 44px;
    border: 6px solid rgba(255, 255, 255, 0.8);
    border-radius: var(--radius);
    background: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .media-placeholder--video .media-placeholder__mark {
    clip-path: polygon(24% 15%, 24% 85%, 88% 50%);
    border: 0;
    background: #ffffff;
  }

  .media-placeholder__label {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    color: var(--color-primary-dark);
    padding: 0.4rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: var(--shadow-xs);
  }
</style>
