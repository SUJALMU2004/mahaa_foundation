---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { formatActivityDate } from '../../utils/media';

export interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  date?: string;
  dateLabel: string;
  location: string;
  image: string;
  imageAlt: string;
  variant?: 'default' | 'modern';
}

const {
  title,
  description,
  href,
  category,
  date,
  dateLabel,
  location,
  image,
  imageAlt,
  variant = 'default',
} = Astro.props;
const mediaVariant = variant === 'modern' ? 'clean' : 'default';
---

<article class="activity-card">
  <div class="activity-card__media-wrapper">
    <MediaPlaceholder type="image" label={imageAlt} image={image} variant={mediaVariant} />
  </div>
  <div class="activity-card__content">
    <p class="activity-card__category">{category}</p>
    <p class="activity-card__meta">
      {date ? <time datetime={date}>{formatActivityDate(date, dateLabel)}</time> : <span>{dateLabel}</span>}
      <span aria-hidden="true" class="activity-card__meta-sep">|</span>
      <span>{location}</span>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="activity-card__link" href={href}>View Activity</a>
  </div>
</article>

<style>
  .activity-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: transparent;
    transition: transform var(--transition);
  }

  .activity-card:hover {
    transform: translateY(-2px);
  }

  .activity-card__media-wrapper {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .activity-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-4) 0 0 0;
  }

  .activity-card__category {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .activity-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-bottom: var(--space-3);
  }

  .activity-card__meta-sep {
    color: var(--color-border);
  }

  .activity-card h3 {
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .activity-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .activity-card h3 a:hover {
    color: var(--color-primary);
  }

  .activity-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .activity-card__link {
    display: inline-flex;
    width: fit-content;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    text-underline-offset: 0.22em;
    transition: color var(--transition);
  }

  .activity-card__link:hover {
    color: var(--color-primary-light);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-card {
      transition: none;
    }
    .activity-card:hover {
      transform: none;
    }
  }
</style>
