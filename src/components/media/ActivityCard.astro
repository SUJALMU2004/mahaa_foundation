---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { formatActivityDate } from '../../utils/media';

export interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  date?: string;
  dateLabel: string;
  location: string;
  image: string;
  imageAlt: string;
  variant?: 'default' | 'modern';
}

const {
  title,
  description,
  href,
  category,
  date,
  dateLabel,
  location,
  image,
  imageAlt,
  variant = 'default',
} = Astro.props;
const mediaVariant = variant === 'modern' ? 'clean' : 'default';
---

<article class:list={['activity-card', `activity-card--${variant}`]}>
  <MediaPlaceholder type="image" label={imageAlt} image={image} variant={mediaVariant} />
  <div class="activity-card__content">
    <p class="activity-card__category">{category}</p>
    <p class="activity-card__meta">
      {date ? <time datetime={date}>{formatActivityDate(date, dateLabel)}</time> : <span>{dateLabel}</span>}
      <span aria-hidden="true">|</span>
      <span>{location}</span>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="activity-card__link" href={href}>View Activity</a>
  </div>
</article>

<style>
  .activity-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: 0 12px 34px rgb(23 35 29 / 0.06);
  }

  .activity-card--modern {
    display: flex;
    height: 100%;
    flex-direction: column;
    box-shadow: 0 10px 28px rgb(23 35 29 / 0.05);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .activity-card--modern:hover,
  .activity-card--modern:focus-within {
    border-color: rgb(23 107 58 / 0.3);
    box-shadow: 0 18px 44px rgb(23 35 29 / 0.1);
    transform: translateY(-3px);
  }

  .activity-card__content {
    padding: var(--space-4);
  }

  .activity-card--modern .activity-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .activity-card__category {
    margin-bottom: var(--space-2);
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .activity-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .activity-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .activity-card h3 a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .activity-card h3 a:focus-visible,
  .activity-card__link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .activity-card p {
    color: var(--color-muted);
  }

  .activity-card__link {
    margin-top: auto;
    color: var(--color-primary-dark);
    font-weight: 900;
  }

  .activity-card--modern .activity-card__link {
    display: inline-flex;
    width: fit-content;
    border-radius: var(--radius);
    padding-top: var(--space-2);
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-card--modern {
      transition: none;
    }

    .activity-card--modern:hover,
    .activity-card--modern:focus-within {
      transform: none;
    }
  }
</style>
