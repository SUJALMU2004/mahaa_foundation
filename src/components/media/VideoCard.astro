---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import MediaPlaceholder from './MediaPlaceholder.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  poster: string;
  videoSrc?: string;
  duration?: string;
  relatedHref?: string;
  videoAltText: string;
}

const {
  title,
  description,
  category,
  poster,
  videoSrc,
  duration,
  relatedHref,
  videoAltText,
} = Astro.props;

import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const content = {
  en: {
    durationLabel: 'Duration',
    notice: 'Real local video can be added later in public/videos/.',
    viewRelated: 'View related work',
  },
  kn: {
    durationLabel: 'ಅವಧಿ',
    notice: 'ನೈಜ ಸ್ಥಳೀಯ ವೀಡಿಯೊವನ್ನು ನಂತರ public/videos/ ನಲ್ಲಿ ಸೇರಿಸಬಹುದು.',
    viewRelated: 'ಸಂಬಂಧಿತ ಕೆಲಸವನ್ನು ವೀಕ್ಷಿಸಿ',
  }
};
const t = content[lang];

const videoFilePath = videoSrc ? join(process.cwd(), 'public', videoSrc.replace(/^\/+/, '')) : '';
const hasLocalVideo = Boolean(videoSrc && existsSync(videoFilePath));
---

<article class="video-card">
  <div class="video-card__media-wrapper">
    <div class="video-card__media">
      {
        hasLocalVideo && videoSrc ? (
          <video controls preload="metadata" poster={poster} aria-label={videoAltText}>
            <source src={videoSrc} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        ) : (
          <MediaPlaceholder type="video" label={videoAltText} image={poster} aspectRatio="16 / 9" />
        )
      }
    </div>
  </div>
  <div class="video-card__content">
    <p class="video-card__category">{category}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    {
      duration && <p class="video-card__duration">{t.durationLabel}: {duration}</p>
    }
    {
      !hasLocalVideo && (
        <p class="video-card__notice">{t.notice}</p>
      )
    }
    {
      relatedHref && (
        <a class="video-card__link" href={translatePath(relatedHref, lang)}>
          {t.viewRelated}
        </a>
      )
    }
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: transparent;
    transition: transform var(--transition);
  }

  .video-card:hover {
    transform: translateY(-2px);
  }

  .video-card__media-wrapper {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .video-card__media video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-primary-soft);
    object-fit: cover;
  }

  .video-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4) 0 0 0;
  }

  .video-card__category {
    margin-bottom: var(--space-2);
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .video-card h3 {
    margin-bottom: var(--space-2);
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .video-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .video-card__duration {
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: auto;
    color: var(--color-primary) !important;
  }

  .video-card__notice {
    font-size: 0.8rem;
    margin-top: auto;
    opacity: 0.8;
  }

  .video-card__link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    margin-top: var(--space-3);
    transition: color var(--transition);
  }

  .video-card__link:hover {
    color: var(--color-primary-light);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-card {
      transition: none;
    }
    .video-card:hover {
      transform: none;
    }
  }
</style>
