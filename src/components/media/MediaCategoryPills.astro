---
import type { MediaCategory } from '../../data/media';

export interface Props {
  categories: MediaCategory[];
  ariaLabel?: string;
}

const { categories, ariaLabel = 'Media categories' } = Astro.props;
---

<nav class="category-pills" aria-label={ariaLabel}>
  {categories.map((category) => <a href={category.href}>{category.label}</a>)}
</nav>

<style>
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .category-pills a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    color: var(--color-text);
    padding: 0.45rem 0.85rem;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: border-color var(--transition), background-color var(--transition), color var(--transition);
  }

  .category-pills a:hover {
    border-color: rgba(15, 107, 69, 0.25);
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }
</style>
