---
import { formatActivityDate } from '../../utils/media';

export interface Props {
  date?: string;
  dateLabel: string;
  location: string;
  category: string;
  time?: string;
}

const { date, dateLabel, location, category, time } = Astro.props;
---

<dl class="activity-meta">
  <div class="activity-meta__item">
    <dt>Date</dt>
    <dd>
      {date ? <time datetime={date}>{formatActivityDate(date, dateLabel)}</time> : <span>{dateLabel}</span>}
    </dd>
  </div>
  {
    time && (
      <div class="activity-meta__item">
        <dt>Time</dt>
        <dd>{time}</dd>
      </div>
    )
  }
  <div class="activity-meta__item">
    <dt>Location</dt>
    <dd>{location}</dd>
  </div>
  <div class="activity-meta__item">
    <dt>Category</dt>
    <dd>{category}</dd>
  </div>
</dl>

<style>
  .activity-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }

  .activity-meta__item {
    flex: 1 1 calc(50% - var(--space-3));
    min-width: 140px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--shadow-xs);
  }

  .activity-meta dt {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }

  .activity-meta dd {
    margin: 0;
    color: var(--color-text);
    font-weight: 700;
    font-size: 0.94rem;
  }

  @media (min-width: 640px) {
    .activity-meta__item {
      flex: 1 1 auto;
    }
  }
</style>
