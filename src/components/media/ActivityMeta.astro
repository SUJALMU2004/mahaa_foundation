---
import { formatActivityDate } from '../../utils/media';

export interface Props {
  date?: string;
  dateLabel: string;
  location: string;
  category: string;
  time?: string;
}

const { date, dateLabel, location, category, time } = Astro.props;
---

<dl class="activity-meta">
  <div>
    <dt>Date</dt>
    <dd>
      {date ? <time datetime={date}>{formatActivityDate(date, dateLabel)}</time> : <span>{dateLabel}</span>}
    </dd>
  </div>
  {
    time && (
      <div>
        <dt>Time</dt>
        <dd>{time}</dd>
      </div>
    )
  }
  <div>
    <dt>Location</dt>
    <dd>{location}</dd>
  </div>
  <div>
    <dt>Category</dt>
    <dd>{category}</dd>
  </div>
</dl>

<style>
  .activity-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }

  .activity-meta div {
    min-width: 8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    padding: var(--space-3);
  }

  .activity-meta dt {
    color: var(--color-muted);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .activity-meta dd {
    margin: 0;
    color: var(--color-text);
    font-weight: 900;
  }
</style>
