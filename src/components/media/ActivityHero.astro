---
import Button from '../common/Button.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import ActivityMeta from './ActivityMeta.astro';

export interface Props {
  title: string;
  kannadaTitle?: string;
  description: string;
  category: string;
  date?: string;
  dateLabel: string;
  time?: string;
  location: string;
  image: string;
  imageAlt: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
}

const {
  title,
  kannadaTitle,
  description,
  category,
  date,
  dateLabel,
  time,
  location,
  image,
  imageAlt,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="activity-hero">
  <div class="activity-hero__content">
    <p class="activity-hero__eyebrow">{category}</p>
    <h1>{title}</h1>
    {kannadaTitle && <p class="activity-hero__kannada">{kannadaTitle}</p>}
    <p class="activity-hero__description">{description}</p>
    <ActivityMeta date={date} dateLabel={dateLabel} time={time} location={location} category={category} />
    <div class="activity-hero__actions">
      <Button href={primaryCta.href} variant="primary">{primaryCta.label}</Button>
      <Button href={secondaryCta.href} variant="outline">{secondaryCta.label}</Button>
    </div>
  </div>
  <div class="activity-hero__media-wrapper">
    <MediaPlaceholder type="image" label={imageAlt} image={image} aspectRatio="16 / 10" />
  </div>
</section>

<style>
  .activity-hero {
    display: grid;
    gap: var(--space-7);
    width: min(100% - 2.5rem, var(--container));
    margin: 0 auto;
    padding: var(--space-8) 0;
    align-items: center;
  }

  .activity-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .activity-hero__eyebrow::before {
    content: "";
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--gradient-accent);
    border-radius: 999px;
  }

  .activity-hero h1 {
    max-width: 15ch;
  }

  .activity-hero__description {
    max-width: 760px;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .activity-hero__kannada {
    max-width: 760px;
    margin-top: var(--space-3);
    color: var(--color-primary-dark);
    font-size: 1.08rem;
    font-weight: 700;
  }

  .activity-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .activity-hero__media-wrapper {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 900px) {
    .activity-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    }
  }
</style>
