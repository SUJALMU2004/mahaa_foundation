---
import MediaPlaceholder from './MediaPlaceholder.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  image: string;
  imageAlt: string;
  caption: string;
  href?: string;
}

const { title, description, category, image, imageAlt, caption, href } = Astro.props;
---

<article class="gallery-card">
  <MediaPlaceholder type="image" label={imageAlt} image={image} variant="clean" />
  <div class="gallery-card__content">
    <p class="gallery-card__category">{category}</p>
    <h3>
      {
        href ? (
          <a href={href}>{title}</a>
        ) : (
          title
        )
      }
    </h3>
    <p>{description}</p>
    <p class="gallery-card__caption">{caption}</p>
  </div>
</article>

<style>
  .gallery-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: 0 10px 28px rgb(23 35 29 / 0.05);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .gallery-card:hover,
  .gallery-card:focus-within {
    border-color: rgb(23 107 58 / 0.28);
    box-shadow: 0 18px 44px rgb(23 35 29 / 0.1);
    transform: translateY(-3px);
  }

  .gallery-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .gallery-card__category {
    margin-bottom: var(--space-2);
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gallery-card h3 {
    margin-bottom: var(--space-2);
    font-size: clamp(1.08rem, 1vw + 0.85rem, 1.28rem);
  }

  .gallery-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .gallery-card h3 a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .gallery-card p {
    color: var(--color-muted);
  }

  .gallery-card__caption {
    margin-top: auto;
    margin-bottom: 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 800;
    padding-top: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card {
      transition: none;
    }

    .gallery-card:hover,
    .gallery-card:focus-within {
      transform: none;
    }
  }
</style>
