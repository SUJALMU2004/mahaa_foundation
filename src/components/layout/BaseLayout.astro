---
import '../../styles/global.css';
import Header from '../common/Header.astro';
import Footer from '../common/Footer.astro';
import FloatingWhatsAppButton from '../cta/FloatingWhatsAppButton.astro';
import StickyMobileCta from '../cta/StickyMobileCta.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Seo from '../common/Seo.astro';
import JsonLd from '../common/JsonLd.astro';
import { site } from '../../data/site';
import { absoluteUrl } from '../../utils/seo';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  robots?: string;
  publishedDate?: string;
  modifiedDate?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { schema, ...seoProps } = Astro.props;

const verifiedSocialLinks = site.socialLinks.filter((link) => link.url);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': site.organizationType,
  name: site.siteName,
  alternateName: site.shortName,
  url: site.url,
  logo: absoluteUrl(site.logo),
  description: site.description,
  telephone: '+917019170976',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Vinayak Medical Shop, Double Rd',
    addressLocality: site.city,
    addressRegion: site.state,
    postalCode: '587312',
    addressCountry: site.country,
  },
  areaServed: site.areaServed.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
  founder: {
    '@type': 'Person',
    name: site.founder,
  },
  foundingDate: site.founded,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+917019170976',
    email: site.email,
    contactType: 'NGO Enquiry',
    areaServed: 'IN',
    availableLanguage: ['English', 'Hindi', 'Kannada'],
  },
  ...(verifiedSocialLinks.length > 0
    ? { sameAs: verifiedSocialLinks.map((link) => link.url) }
    : {}),
};

const structuredData = schema
  ? [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : organizationSchema;
---

<!doctype html>
<html lang={site.defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#176b3a" />
    <link rel="icon" href="/images/favicon/favicon.ico" sizes="any" />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/images/favicon/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <Seo {...seoProps} />
    <JsonLd data={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsAppButton />
    <StickyMobileCta />
    <SpeedInsights />
  </body>
</html>
