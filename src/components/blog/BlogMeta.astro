---
import { formatDate } from '../../utils/blog';

export interface Props {
  publishDate: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: string;
}

const { publishDate, updatedDate, author, readingTime } = Astro.props;
---

<div class="blog-meta">
  <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
  {updatedDate && <span class="blog-meta__item">Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
  {author && <span class="blog-meta__item">{author}</span>}
  {readingTime && <span class="blog-meta__item">{readingTime}</span>}
</div>

<style>
  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .blog-meta__item,
  .blog-meta time {
    display: inline-flex;
    align-items: center;
  }

  .blog-meta__item::before {
    content: "";
    display: inline-block;
    width: 0.3rem;
    height: 0.3rem;
    margin-right: var(--space-3);
    border-radius: 50%;
    background: var(--color-accent);
  }
</style>
