---
import BlogMeta from './BlogMeta.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  publishDate: Date;
  updatedDate?: Date;
  author: string;
  readingTime: string;
  tags: readonly string[];
  image: string;
  imageAlt: string;
}

const {
  title,
  description,
  category,
  publishDate,
  updatedDate,
  author,
  readingTime,
  tags,
  image,
  imageAlt,
} = Astro.props;
---

<header class="article-header">
  <p class="article-header__category">{category}</p>
  <h1>{title}</h1>
  <p class="article-header__description">{description}</p>
  <BlogMeta
    publishDate={publishDate}
    updatedDate={updatedDate}
    author={author}
    readingTime={readingTime}
  />
  <ul class="article-header__tags" aria-label="Post tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="article-header__media">
    <img
      src={image}
      alt={imageAlt}
      width="1200"
      height="675"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</header>

<style>
  .article-header {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-8) 1rem var(--space-5);
  }

  .article-header__category {
    display: inline-flex;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    padding: 0.35rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .article-header h1 {
    max-width: 15ch;
    margin-bottom: var(--space-3);
  }

  .article-header__description {
    max-width: 760px;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  .article-header__tags li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-muted);
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .article-header__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    box-shadow: var(--shadow-md);
    margin-top: var(--space-5);
  }

  .article-header__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
