---
import Container from '../common/Container.astro';

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="blog-hero" aria-labelledby="blog-hero-title">
  <Container>
    <p>{eyebrow}</p>
    <h1 id="blog-hero-title">{title}</h1>
    <div>
      <span aria-hidden="true"></span>
      <p>{description}</p>
    </div>
  </Container>
</section>

<style>
  .blog-hero {
    padding: var(--space-7) 0;
    background:
      radial-gradient(circle at top left, rgb(232 243 235 / 0.9), transparent 30rem),
      #ffffff;
  }

  .blog-hero :global(.container) {
    max-width: 900px;
  }

  .blog-hero > :global(.container) > p {
    margin-bottom: var(--space-3);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-hero div {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .blog-hero span {
    display: block;
    width: 72px;
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  }

  .blog-hero div p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  @media (min-width: 720px) {
    .blog-hero div {
      grid-template-columns: 90px 1fr;
    }
  }
</style>
