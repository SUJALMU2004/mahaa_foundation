---
import BlogMeta from './BlogMeta.astro';

export interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  category: string;
  publishDate: Date;
  tags?: readonly string[];
  variant?: 'default' | 'modern' | 'featured';
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  category,
  publishDate,
  tags = [],
  variant = 'default',
} = Astro.props;
---

<article class:list={['blog-card', `blog-card--${variant}`]}>
  <div class="blog-card__media-wrapper">
    <div class="blog-card__media">
      <img src={image} alt={imageAlt} width="720" height="450" loading="lazy" decoding="async" />
      <span>{category}</span>
    </div>
  </div>
  <div class="blog-card__body">
    <BlogMeta publishDate={publishDate} />
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    {
      tags.length > 0 && (
        <ul aria-label="Post tags">
          {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
        </ul>
      )
    }
    <a class="blog-card__link" href={href}>Read More</a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .blog-card:hover {
    border-color: rgba(15, 107, 69, 0.22);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .blog-card__media-wrapper {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-soft);
  }

  .blog-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .blog-card__media span {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: var(--color-primary);
    padding: 0.35rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .blog-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-4);
  }

  .blog-card h3 {
    margin: var(--space-2) 0;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .blog-card--modern h3,
  .blog-card--default h3 {
    min-height: 3.1em;
  }

  .blog-card h3 a {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .blog-card h3 a:hover {
    color: var(--color-primary);
  }

  .blog-card p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: var(--space-3);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .blog-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .blog-card li {
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-muted);
    padding: 0.2rem 0.45rem;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .blog-card__link {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
    text-underline-offset: 0.22em;
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-card__link:hover {
    color: var(--color-primary-light);
    text-decoration: underline;
  }

  @media (min-width: 820px) {
    .blog-card--featured {
      display: grid;
      grid-template-columns: minmax(320px, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }

    .blog-card--featured .blog-card__media-wrapper {
      height: 100%;
      border-right: 1px solid var(--color-border);
      border-bottom: 0;
    }

    .blog-card--featured .blog-card__media {
      height: 100%;
      aspect-ratio: auto;
    }

    .blog-card--featured .blog-card__body {
      padding: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
    .blog-card:hover {
      transform: none;
    }
  }
</style>
