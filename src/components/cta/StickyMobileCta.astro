---
import { site } from '../../data/site';
import { whatsappUrl } from '../../utils/seo';
---

<nav class="sticky-mobile-cta" aria-label="Quick contact actions">
  <a href={site.phoneHref} aria-label="Call Mahaa Foundation">Call</a>
  <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Mahaa Foundation">
    WhatsApp
  </a>
</nav>

<style>
  .sticky-mobile-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 36;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    background: #ffffff;
    box-shadow: 0 -8px 28px rgba(7, 59, 42, 0.12);
  }

  .sticky-mobile-cta a {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .sticky-mobile-cta a:hover {
    opacity: 0.9;
    color: #ffffff;
  }

  .sticky-mobile-cta a:first-child {
    background: var(--color-primary);
  }

  .sticky-mobile-cta a:last-child {
    background: var(--color-whatsapp);
  }

  @media (min-width: 760px) {
    .sticky-mobile-cta {
      display: none;
    }
  }

  @media (max-width: 759px) {
    :global(body) {
      padding-bottom: 52px;
    }
  }
</style>
