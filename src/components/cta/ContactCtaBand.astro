---
import Button from '../common/Button.astro';
import { site } from '../../data/site';
import { whatsappUrl } from '../../utils/seo';

export interface Props {
  title: string;
  description: string;
  showCall?: boolean;
  showWhatsApp?: boolean;
  showEmail?: boolean;
  showLocation?: boolean;
}

const {
  title,
  description,
  showCall = true,
  showWhatsApp = true,
  showEmail = true,
  showLocation = false,
} = Astro.props;
---

<section class="contact-cta-band" aria-labelledby="contact-cta-title">
  <div>
    <h2 id="contact-cta-title">{title}</h2>
    <p>{description}</p>
  </div>
  <div class="contact-cta-band__actions">
    {showCall && <Button href={site.phoneHref} variant="primary">Call Now</Button>}
    {showWhatsApp && <Button href={whatsappUrl()} variant="whatsapp" external>WhatsApp Us</Button>}
    {showEmail && <Button href={site.emailHref} variant="outline">Email Us</Button>}
    {
      showLocation && (
        <Button href={site.locationUrl} variant="outline" external>
          Find Location
        </Button>
      )
    }
  </div>
</section>

<style>
  .contact-cta-band {
    display: grid;
    gap: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(230, 244, 236, 0.7), rgba(255, 248, 234, 0.6)),
      #ffffff;
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .contact-cta-band p {
    max-width: 720px;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .contact-cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 920px) {
    .contact-cta-band {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
