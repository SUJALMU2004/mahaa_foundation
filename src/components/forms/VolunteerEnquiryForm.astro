---
import BaseContactForm from './BaseContactForm.astro';
import FormField from './FormField.astro';
import FormSelect from './FormSelect.astro';
import FormTextarea from './FormTextarea.astro';
import { availabilityOptions, volunteerInterestOptions } from '../../data/contact';
---

<BaseContactForm
  title="Send Volunteer Enquiry"
  description="Share your interest and WhatsApp will open with a pre-filled volunteer enquiry. Please tap Send in WhatsApp to complete it."
  type="volunteer"
  submitLabel="Submit via WhatsApp"
>
  <FormField id="volunteer-name" name="name" label="Full Name" required autocomplete="name" />
  <FormField
    id="volunteer-phone"
    name="phone"
    label="Phone Number"
    required
    inputmode="tel"
    autocomplete="tel"
    pattern="[0-9+\-\s]{10,15}"
    placeholder="Enter your phone number"
  />
  <FormField id="volunteer-email" name="email" label="Email Address" type="email" autocomplete="email" />
  <FormSelect
    id="volunteer-interest"
    name="interest"
    label="Interest Area"
    options={volunteerInterestOptions}
    required
  />
  <FormSelect
    id="volunteer-availability"
    name="availability"
    label="Preferred Availability"
    options={availabilityOptions}
    required
  />
  <FormTextarea
    id="volunteer-message"
    name="message"
    label="Message"
    placeholder="Tell us how you would like to help"
  />
</BaseContactForm>
